create or replace   view BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_hlt_ensure_member
  
   as (
    

-- Staging: OPUS health ensure member details
-- Source: BJAZ_HLT_ENSURE_MEM_DTLS
-- Health Ensure product members
-- BK: PARTNER_ID + CONTRACT_ID + MEMBER_NO

WITH source AS (
    SELECT *
    FROM BAGIC_PROD_MIRROR_DB.OPUS_GG_DWHSTAGE.BJAZ_HLT_ENSURE_MEM_DTLS
    WHERE PARTNER_ID IS NOT NULL
),

staged AS (
    SELECT
        -- Keys
        PARTNER_ID AS PART_ID,
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(PARTNER_ID AS VARCHAR), ''))))
    
 AS hk_prtnr_mstr_cd,
        CONTRACT_ID,
        MEMBER_NO,

        -- Member identity
        NAME,
        DATE_OF_BIRTH,
        AGE,
        GENDER,
        RELATION,
        ASSIGNEE,
