create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_cntct_dtls
         as
        (

-- Satellite Partner Contact Details
-- Hub: hub_prtnr_role (contact can vary by role)
-- Sources: MAXIMUS (address) + OPUS (AZBJ_PARTNER_EXTN, BJAZ_AZBJ_PART_EXT_HIST, BJAZ_CP_PART_HIST)
-- Per OPUS_MAPPING_FINAL: 13 OPUS columns land here (only contact-specific from partner extn)

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        hk_prtnr_mstr_cd
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

multi_set AS (
    SELECT
        PARTY_CODE,
        STAKE_CODE,
        hk_prtnr_role_cd,
        MOBILE_NO,
        EMAIL_ID,
        load_dt_tm,
        record_source
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property
),

maximus_source AS (
    SELECT
        h.hk_prtnr_role_cd,
        h.hk_prtnr_mstr_cd,
        msp.load_dt_tm AS ld_dt_tm,
        msp.record_source AS rcrd_src_nm,
        
        -- Contact columns
        msp.EMAIL_ID,
        msp.MOBILE_NO,
        CONCAT_WS(', ', sp.PHONE_NO_1, sp.PHONE_NO_2, sp.ALTERNATE_MOB_NUMBER, sp.LANDLINE_NUMBER) AS ALT_MOBILE_NO,
        sp.LANDLINE_NO,
        sp.STD_CODE,
        NULL AS ALT_EMAIL_ID,
        NULL AS PREFERRED_CONTACT_OPT,
        NULL AS FAX,
        
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(msp.EMAIL_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.MOBILE_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.LANDLINE_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.STD_CODE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
        
    FROM multi_set msp
    INNER JOIN hub_role h 
        ON h.hk_prtnr_role_cd = msp.hk_prtnr_role_cd
    LEFT JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON msp.PARTY_CODE = sp.PARTY_CODE
    WHERE msp.EMAIL_ID IS NOT NULL
       OR msp.MOBILE_NO IS NOT NULL
       OR sp.LANDLINE_NO IS NOT NULL
),

opus_partner_extn AS (
    SELECT
        h.hk_prtnr_role_cd,
        ope.hk_prtnr_mstr_cd,
        ope.load_dt_tm AS ld_dt_tm,
        ope.record_source AS rcrd_src_nm,
        
        -- Contact columns
        ope.EMAIL_2 AS EMAIL_ID,
        ope.TELEPHONE3 AS MOBILE_NO,
        ope.ALT_MOBILE_NO,
        NULL AS LANDLINE_NO,
        NULL AS STD_CODE,
        ope.ALT_EMAIL_ID,
        ope.PREFERRED_CONTACT_OPT,
        NULL AS FAX,
        
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(ope.TELEPHONE3 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.EMAIL_2 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.ALT_MOBILE_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.ALT_EMAIL_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.PREFERRED_CONTACT_OPT AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
        
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_partner_extn ope
    INNER JOIN hub_role h 
        ON h.prty_id = CAST(ope.PART_ID AS VARCHAR)
    WHERE ope.TELEPHONE3 IS NOT NULL
       OR ope.EMAIL_2 IS NOT NULL
       OR ope.ALT_MOBILE_NO IS NOT NULL
),

opus_partner_extn_hist AS (
    SELECT
        h.hk_prtnr_role_cd,
        opeh.hk_prtnr_mstr_cd,
        opeh.load_dt_tm AS ld_dt_tm,
        opeh.record_source AS rcrd_src_nm,
        
        -- Contact columns
        opeh.EMAIL_2 AS EMAIL_ID,
        opeh.TELEPHONE3 AS MOBILE_NO,
        NULL AS ALT_MOBILE_NO,
        NULL AS LANDLINE_NO,
        NULL AS STD_CODE,
        NULL AS ALT_EMAIL_ID,
        NULL AS PREFERRED_CONTACT_OPT,
        NULL AS FAX,
        
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(opeh.TELEPHONE3 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(opeh.EMAIL_2 AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
        
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_partner_extn_hist opeh
    INNER JOIN hub_role h 
        ON h.prty_id = CAST(opeh.PART_ID AS VARCHAR)
    WHERE opeh.TELEPHONE3 IS NOT NULL
       OR opeh.EMAIL_2 IS NOT NULL
),

opus_partner_hist AS (
    SELECT
        h.hk_prtnr_role_cd,
        oph.hk_prtnr_mstr_cd,
        oph.load_dt_tm AS ld_dt_tm,
        oph.record_source AS rcrd_src_nm,
        
        -- Contact columns
        oph.EMAIL AS EMAIL_ID,
        oph.TELEPHONE AS MOBILE_NO,
        CONCAT_WS(', ', oph.TELEPHONE2, oph.CONTACT1, oph.CONTACT2) AS ALT_MOBILE_NO,
        NULL AS LANDLINE_NO,
        NULL AS STD_CODE,
        NULL AS ALT_EMAIL_ID,
        NULL AS PREFERRED_CONTACT_OPT,
        oph.FAX,
        
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(oph.TELEPHONE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(oph.TELEPHONE2 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(oph.EMAIL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(oph.FAX AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(oph.CONTACT1 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(oph.CONTACT2 AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
        
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_partner_hist oph
    INNER JOIN hub_role h 
        ON h.prty_id = CAST(oph.PART_ID AS VARCHAR)
    WHERE oph.TELEPHONE IS NOT NULL
       OR oph.EMAIL IS NOT NULL
),

combined AS (
    SELECT * FROM maximus_source
    UNION ALL
    SELECT * FROM opus_partner_extn
    UNION ALL
    SELECT * FROM opus_partner_extn_hist
    UNION ALL
    SELECT * FROM opus_partner_hist
)



SELECT * FROM combined


        );
