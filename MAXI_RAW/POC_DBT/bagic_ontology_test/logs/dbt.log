-- Satellite Partner Address Details
-- Hub: hub_prtnr_mstr
-- Sources: MAXIMUS (stg_partner_address) + OPUS (stg_opus_address, stg_opus_address_extn, stg_opus_address_hist)

WITH hub_mstr AS (
