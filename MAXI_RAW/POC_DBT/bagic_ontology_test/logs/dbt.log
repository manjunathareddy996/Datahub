create or replace transient table BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_bsnss_cmplnc_dtls
         as
        (

-- Satellite Partner Business Compliance Details
-- Hub: hub_prtnr_role (business compliance per role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: GST, registration, statewise GSTIN, business details

-- Get STAKE_CODE from multi-set property to create role-level hash key
multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

        -- GST details
        sp.GST_APPLICABLE,
        sp.GST_NUMBER,
        sp.GST_REGISTRATION_DATE,
        sp.GST_STATE,
        sp.GST_TYPE,
        sp.GSTIN,
        sp.GSTIN_NUMBER,

        -- Statewise GSTIN
        sp.STATEWISE_GSTIN_1,
        sp.STATEWISE_GSTIN_2,
        sp.STATEWISE_GSTIN_3,
        sp.STATEWISE_GSTIN_STATE_1,
        sp.STATEWISE_GSTIN_STATE_2,

        -- Registration
        sp.REGISTRATION_NUMBER,
        sp.REGISTRATION_DATE,
        sp.REGISTRATION_VALID_TILL,
        sp.REGISTRATION_TYPE,

        -- Business details
        sp.BUSINESS_TYPE,
        sp.BUSINESS_CATEGORY,
        sp.BUSINESS_NATURE,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.GST_APPLICABLE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.GST_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.GSTIN AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.GSTIN_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.REGISTRATION_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.REGISTRATION_DATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BUSINESS_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BUSINESS_CATEGORY AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)



SELECT * FROM source


        );
