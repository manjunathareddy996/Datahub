create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_srvyr_invstgtr_dtls
         as
        (

-- Satellite Partner Surveyor Investigator Details
-- Hub: hub_prtnr_role (SURVEYOR/INVESTIGATOR/DEALER/REPAIRER/LAWYER roles)
-- Sources: MAXIMUS (simple property) + OPUS (BJAZ_CLM_SUPP_EXTN + CLM_SUPPLIERS)
-- Per OPUS_MAPPING_FINAL: ALL 127 columns from these 2 OPUS tables land here

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd, 
        prty_id, 
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

maximus_source AS (
    SELECT
        h.hk_prtnr_role_cd,
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,
        
        -- Surveyor details from simple property
        sp.SURVEYOR_ID AS supp_id,
        sp.SURVEYOR_CATEGORY AS surveyor_category,
        sp.SURVEYOR_LICENSE_NUMBER AS surveyor_license_no,
        sp.SURVEYOR_GRADE AS grade,
        sp.SURVEYOR_CLASS AS class,
        NULL AS supp_type,
        NULL AS supp_status,
        
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.SURVEYOR_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SURVEYOR_CATEGORY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SURVEYOR_LICENSE_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SURVEYOR_GRADE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SURVEYOR_CLASS AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp
    INNER JOIN hub_role h 
        ON h.prty_id = CAST(sp.PARTY_CODE AS VARCHAR)
    WHERE sp.SURVEYOR_ID IS NOT NULL
),

