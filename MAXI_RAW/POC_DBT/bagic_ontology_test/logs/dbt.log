create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL._test_sat_prtnr_prfl_misc_dtls
         as
        (

-- Satellite Partner Profile Miscellaneous Details
-- Hub: hub_prtnr_role (catch-all for remaining profile attributes)
-- Sources: MAXIMUS (simple property) + OPUS (AZBJ_PARTNER_EXTN, BJAZ_AZBJ_PART_EXT_HIST,
--          BJAZ_CP_PART_HIST, CLM_INTERESTED_PARTIES, OCP_INTERESTED_PARTIES)
-- Per OPUS_MAPPING_FINAL: 69 OPUS columns land here

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
    LIMIT 1000
),

hub_mstr AS (
    SELECT 
        hk_prtnr_mstr_cd,
        prty_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_mstr
    LIMIT 1000
),

multi_set AS (
    SELECT
        PARTY_CODE,
        STAKE_CODE,
        hk_prtnr_role_cd,
        TYPE_OF_PARTY,
        PARTY_STATUS
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property
    LIMIT 1000
),

maximus_source AS (
    SELECT
        h.hk_prtnr_role_cd,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        -- MAXIMUS columns
        sp.REMARKS,
        sp.REFERENCE_CODE,
        sp.CATEGORY,
        sp.RATING,
        sp.EFFECTIVE_DATE,
        sp.EXPIRY_DATE,

        -- Placeholder for OPUS columns
        NULL AS PARENT_CO,
        NULL AS INDUSTRY,
        NULL AS PLACE_OF_BIRTH,
        NULL AS PA_CODE,
        NULL AS UCIC_FLAG,
        NULL AS HNI_FLAG,
        NULL AS MSME_FLAG,
        NULL AS VIP_CUST,
        NULL AS SUBCODE,
        NULL AS AVAILABILITY_TIME,
        NULL AS CAUSE_OF_DEATH,
        NULL AS DNI,
        NULL AS LUA_VALUE_1,
        NULL AS LUA_VALUE_2,
        NULL AS TAX_ID,
        NULL AS VAT_NUMBER,
        NULL AS NATIONAL_ID,
        NULL AS CLAIM_ID,
        NULL AS IP_NO,
        NULL AS IP_TYPE,
        NULL AS CLAIMANT,
        NULL AS OBJECT_TYPE,
        NULL AS OCP_PART_ID,
        NULL AS OCP_IP_NO,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.REMARKS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.CATEGORY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.RATING AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EFFECTIVE_DATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EXPIRY_DATE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_role h
    INNER JOIN multi_set ms 
        ON h.prty_id = ms.PARTY_CODE 
        AND h.stake_cd = ms.STAKE_CODE
    LEFT JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON h.prty_id = sp.PARTY_CODE
),

opus_partner_extn AS (
    SELECT
        hm.hk_prtnr_mstr_cd AS hk_prtnr_role_cd,
        ope.load_dt_tm AS ld_dt_tm,
        ope.record_source AS rcrd_src_nm,
        
        -- MAXIMUS placeholders
        NULL AS REMARKS,
        NULL AS REFERENCE_CODE,
        NULL AS CATEGORY,
        NULL AS RATING,
        NULL AS EFFECTIVE_DATE,
        NULL AS EXPIRY_DATE,
        
        -- OPUS partner_extn columns
        ope.PARENT_CO,
        ope.INDUSTRY,
        ope.PLACE_OF_BIRTH,
        ope.PA_CODE,
        ope.UCIC_FLAG,
        ope.HNI_FLAG,
        ope.MSME_FLAG,
        ope.VIP_CUST,
        NULL AS SUBCODE,
        NULL AS AVAILABILITY_TIME,
        NULL AS CAUSE_OF_DEATH,
        NULL AS DNI,
        NULL AS LUA_VALUE_1,
        NULL AS LUA_VALUE_2,
        NULL AS TAX_ID,
        NULL AS VAT_NUMBER,
        NULL AS NATIONAL_ID,
        NULL AS CLAIM_ID,
        NULL AS IP_NO,
        NULL AS IP_TYPE,
        NULL AS CLAIMANT,
        NULL AS OBJECT_TYPE,
        NULL AS OCP_PART_ID,
        NULL AS OCP_IP_NO,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(ope.PARENT_CO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.INDUSTRY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.PLACE_OF_BIRTH AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.PA_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.UCIC_FLAG AS VARCHAR), '')))
