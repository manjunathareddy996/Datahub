[0m16:29:09.983959 [debug] [Thread-2 (]: On model.bagic_ontology.stg_partner_relation: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "demo_dbt", "target_name": "dev", "node_id": "model.bagic_ontology.stg_partner_relation"} */
create or replace   view BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_relation
  
   as (
    

-- Staging: Partner relations (roles/stake codes)
-- Source: BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_RELATION
-- This gives us the STAKE_CODE for hub_prtnr_role

WITH source AS (
    SELECT *
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_RELATION
),

-- Join back to party detail to get PARTY_CODE
party_detail AS (
    SELECT FOREIGN_KEY, PARTY_CODE
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL
    WHERE PARTY_CODE IS NOT NULL
),

staged AS (
    SELECT
        pd.PARTY_CODE,
        -- The relation table likely has STAKE_NAME or similar column for the role
        -- Based on the JSON structure: partyRelation[].stakeName
        src.FOREIGN_KEY,
        src.STAKE_NAME,
        src.ROOT_HASH,
        src.KEY_HASH,
        src.INC_JOB_CREATED_AT,
        src.REC_REFRESH_AT,
        
        -- Hash keys
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(pd.PARTY_CODE AS VARCHAR), ''))))
    
 AS hk_prtnr_mstr_cd,
        -- Note: STAKE_CODE column name TBD - may be in the pivot or as a direct column
        -- For now using FOREIGN_KEY as placeholder until actual stake column is confirmed
        
        CURRENT_TIMESTAMP() AS load_dt_tm,
        'MAXIMUS' AS record_source
        
    FROM source src
    LEFT JOIN party_detail pd ON src.FOREIGN_KEY = pd.FOREIGN_KEY
)

SELECT * FROM staged
  );
