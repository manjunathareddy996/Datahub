        FOREIGN_KEY AS part_id,
        MAX(CASE WHEN PARAM_NAME = 'Geo Co-Ordinate Altitude' THEN PARAM_VALUE END) AS geo_coord_altitude,
        MAX(CASE WHEN PARAM_NAME = 'Geo Co-Ordinate Latitude' THEN PARAM_VALUE END) AS geo_coord_latitude,
        MAX(CASE WHEN PARAM_NAME = 'Geo Co-Ordinate Longitude' THEN PARAM_VALUE END) AS geo_coord_longitude,
        MAX(CASE WHEN PARAM_NAME = 'Area' THEN PARAM_VALUE END) AS area,
        MAX(CASE WHEN PARAM_NAME = 'city' THEN PARAM_VALUE END) AS city,
        MAX(CASE WHEN PARAM_NAME = 'Land Mark' THEN PARAM_VALUE END) AS land_mark,
        MAX(CASE WHEN PARAM_NAME = 'Location Type' THEN PARAM_VALUE END) AS location_type,
        MAX(CASE WHEN PARAM_NAME = 'pincode' THEN PARAM_VALUE END) AS pincode,
        MAX(CASE WHEN PARAM_NAME = 'Post office' THEN PARAM_VALUE END) AS post_office,
        MAX(CASE WHEN PARAM_NAME = 'state' THEN PARAM_VALUE END) AS state
    FROM v_address_property
    GROUP BY FOREIGN_KEY
),

v_final AS (
    SELECT
        sp.part_id,
        sp.location_cd,
        sp.addressee,
        sp.addrs_of_coordinating_office,
        sp.crnt_prmnt_ovrseas_addrs_state_ut,
        sp.is_mailing_addrs_same_as_primary,
        sp.addrs_proof,
        sp.addrs_proof_effective_dt,
        sp.corr_local_addrs_city,
        sp.corr_local_addrs_country,
        sp.corr_local_addrs_district,
        sp.corr_local_addrs_line_1,
        sp.corr_local_addrs_line_2,
        sp.corr_local_addrs_line_3,
        sp.corr_local_addrs_state,
        sp.country,
        sp.covered_area_in_kms,
        sp.crnt_prmnt_ovrseas_addrs,
        sp.crnt_prmnt_ovrseas_addrs_city,
        sp.crnt_prmnt_ovrseas_addrs_country,
        sp.crnt_prmnt_ovrseas_addrs_line_1,
        sp.crnt_prmnt_ovrseas_addrs_line_2,
        sp.crnt_prmnt_ovrseas_addrs_line_3,
        sp.crnt_prmnt_ovrseas_addrs_pin_cd,
        sp.crnt_prmnt_ovrseas_addrs_type,
        sp.flg_ovrseas_same_as_corr,
        sp.latitude,
        sp.local_addrs_pin_cd,
        sp.location,
        sp.longitude,
        ap.geo_coord_altitude,
        ap.geo_coord_latitude,
        ap.geo_coord_longitude,
        ap.area,
        ap.city,
        ap.land_mark,
        ap.location_type,
        ap.pincode,
        ap.post_office,
        ap.state,
        'MAXIMUS' AS rcrd_src_nm
    FROM v_simple_pivot sp
    LEFT JOIN v_address_pivot ap
        ON sp.part_id = ap.part_id
)

SELECT * FROM v_final
  );
