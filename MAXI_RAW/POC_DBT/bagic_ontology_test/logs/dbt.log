create or replace transient table BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_emply_dtls
         as
        (

-- Satellite Partner Employee Details
-- Hub: hub_prtnr_role (employee-specific attributes per role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Employee code, user details, acceptance/issue/submission dates

WITH multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY,
        ms.USER_ID
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

        -- Employee identification
        sp.EMPLOYEE_NO AS EMPLOYEE_CODE,
        NULL AS EMPLOYEE_ID,
        sp.EMPLOYEE_NAME,
        sp.EMPLOYEE_GRADE AS EMPLOYEE_TYPE,
        sp.EMPLOYEE_STATUS,
        sp.EMPLOYEE_ROLE AS EMPLOYEE_DESIGNATION,
        NULL AS EMPLOYEE_DEPARTMENT,

        -- User details
        ms.USER_ID,
        NULL AS USER_NAME,
        NULL AS USER_TYPE,
        NULL AS USER_STATUS,

        -- Key dates
        sp.DATE_OF_ACCEPTANCE_OF_RESIGNATION AS DATE_OF_ACCEPTANCE,
        sp.DATE_OF_ISSUE_OF_APPOINTMENT AS DATE_OF_ISSUE,
        sp.DATE_OF_SUBMITTING_RESIGNATION AS DATE_OF_SUBMITTING,
        NULL AS DATE_OF_JOINING,
        NULL AS DATE_OF_LEAVING,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.EMPLOYEE_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EMPLOYEE_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EMPLOYEE_STATUS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EMPLOYEE_DESIGNATION AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.USER_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.DATE_OF_ACCEPTANCE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)



SELECT * FROM source


        );
