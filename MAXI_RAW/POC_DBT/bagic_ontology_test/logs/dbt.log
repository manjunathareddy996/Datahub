create or replace  temporary view BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_agnt_dtls__dbt_tmp
  
   as (
    

-- Satellite Partner Agent Details
-- Hub: hub_prtnr_mstr (agent attributes are person-level, not role-specific)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Branch, license, IRDA, channel, intermediary details

WITH hub_mstr AS (
    SELECT 
        hk_prtnr_mstr_cd,
        prty_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_mstr
),

source AS (
    SELECT
        h.hk_prtnr_mstr_cd,
        h.prty_id AS PARTY_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.PARTY_STATUS AS status,

        -- Branch details
        sp.BRANCH_CODE,
        sp.BRANCH_NAME,
        sp.BRANCH AS BRANCH_OFFICE,
        NULL AS BRANCH_STATE,

        -- License / IRDA
        sp.LICENSE_NUMBER,
        sp.LICENSE_ISSUE_DATE AS LICENSE_VALID_FROM,
        sp.LICENSE_EXPIRY_DATE AS LICENSE_VALID_TO,
        sp.IRDA_CODE AS IRDA_LICENSE_NUMBER,
        NULL AS IRDA_LICENSE_VALID_FROM,
        NULL AS IRDA_LICENSE_VALID_TO,

        -- Channel / Intermediary
        sp.AGENT_CHANNEL AS CHANNEL,
        sp.SUB_CHANNEL,
        NULL AS INTERMEDIARY_CODE,
        NULL AS INTERMEDIARY_NAME,
        sp.INTERMEDIARY_TYPE,

        -- Agent classification
        NULL AS AGENT_CODE,
        NULL AS AGENT_TYPE,
        sp.EMPLOYEE_STATUS AS AGENT_STATUS,
        NULL AS AGENT_CATEGORY,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.BRANCH_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.LICENSE_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.IRDA_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.AGENT_CHANNEL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SUB_CHANNEL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.INTERMEDIARY_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EMPLOYEE_STATUS AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_mstr h
    INNER JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON h.prty_id = sp.PARTY_CODE
)


, existing AS (
    SELECT hk_prtnr_mstr_cd, rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_agnt_dtls
    QUALIFY ROW_NUMBER() OVER (PARTITION BY hk_prtnr_mstr_cd ORDER BY ld_dt_tm DESC) = 1
)

SELECT s.*
FROM source s
LEFT JOIN existing e ON s.hk_prtnr_mstr_cd = e.hk_prtnr_mstr_cd
WHERE e.hk_prtnr_mstr_cd IS NULL
