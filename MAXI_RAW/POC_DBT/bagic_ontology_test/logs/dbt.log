create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_mstr
         as
        (

-- Hub Partner Master: One row per unique partner (person/entity)
-- Business Key: PARTY_CODE
-- Grain: One partner = one row regardless of roles

WITH source AS (
    SELECT
        hk_prtnr_mstr_cd,
        PARTY_CODE,
        load_dt_tm,
        record_source
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_detail
),



new_records AS (
    SELECT DISTINCT
        hk_prtnr_mstr_cd,
        PARTY_CODE AS prty_id,
        load_dt_tm AS ld_dt_tm,
        record_source AS rcrd_src_nm
    FROM source
    
)

SELECT * FROM new_records
        );
