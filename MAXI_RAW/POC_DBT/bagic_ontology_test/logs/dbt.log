create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_addrs_dtls
         as
        (

-- Satellite Partner Address Details
-- Hub: hub_prtnr_mstr (address is person-level)
-- Source: PARTY_ADDRESS + ADDRESS_PROPERTY_PIVOT

WITH hub_mstr AS (
    SELECT 
        hk_prtnr_mstr_cd,
        prty_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_mstr
),

stg_address AS (
    SELECT
        PARTY_CODE,
        
        -- Address fields
        ADDRESS1,
        ADDRESS2,
        ADDRESS3,
        ADDRESS_TYPE,
        CITY,
        COUNTRY,
        DISTRICT,
        PINCODE,
        STATE,
        
        -- Address property pivot
        AREA,
        GEO_COORDINATE_ALTITUDE,
        GEO_COORDINATE_LATITUDE,
        GEO_COORDINATE_LONGITUDE,
        LAND_MARK,
        LOCATION_TYPE,
        POST_OFFICE,
        WHATSAPP_NO,
        
        -- Contact (from address table)
        ALTERNATE_EMAIL_ID,
        EMAIL_ID,
        FAX,
        LANDLINE_NO,
        MOBILE_NO,
        PHONE_NO,
        STD_CODE,
        WORK_NO,
        
        -- Metadata
        load_dt_tm,
        record_source
        
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_address
),

source AS (
    SELECT
        h.hk_prtnr_mstr_cd,
        h.prty_id AS PARTY_CODE,
        
        -- Address fields
        a.ADDRESS1,
        a.ADDRESS2,
        a.ADDRESS3,
        a.ADDRESS_TYPE,
        a.CITY,
        a.COUNTRY,
        a.DISTRICT,
        a.PINCODE,
        a.STATE,
        
        -- Address property pivot
        a.AREA,
        a.GEO_COORDINATE_ALTITUDE,
        a.GEO_COORDINATE_LATITUDE,
        a.GEO_COORDINATE_LONGITUDE,
        a.LAND_MARK,
        a.LOCATION_TYPE,
        a.POST_OFFICE,
        a.WHATSAPP_NO,
        
        -- Contact (from address table)
        a.ALTERNATE_EMAIL_ID,
        a.EMAIL_ID,
        a.FAX,
        a.LANDLINE_NO,
        a.MOBILE_NO,
        a.PHONE_NO,
        a.STD_CODE,
        a.WORK_NO,
        
        -- Metadata
        a.load_dt_tm AS ld_dt_tm,
        a.record_source AS rcrd_src_nm,
        
        -- Hash diff
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(a.ADDRESS1 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(a.ADDRESS2 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(a.ADDRESS3 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(a.ADDRESS_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(a.CITY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(a.COUNTRY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(a.DISTRICT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(a.PINCODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(a.STATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(a.MOBILE_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(a.EMAIL_ID AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
        
    FROM hub_mstr h
    INNER JOIN stg_address a ON h.prty_id = a.PARTY_CODE
)



SELECT * FROM source


        );
