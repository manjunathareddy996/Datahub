        NULL AS AUTOMOBILE_MAKE,
        NULL AS AUTOMOBILE_MODEL,
        NULL AS AUTOMOBILE_TYPE,

        -- Rates / Financials
        sp.LABOR_RATE,
        NULL AS LABOR_RATE_PER_HOUR,
        NULL AS CASH_BACK_PERCENTAGE,
        NULL AS CASH_BACK_AMOUNT,
        NULL AS CASH_BACK_APPLICABLE,
        sp.CASH_BACK_OFFER,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.DEALER_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.DEALER_TYPE AS VARCHAR), '')))
