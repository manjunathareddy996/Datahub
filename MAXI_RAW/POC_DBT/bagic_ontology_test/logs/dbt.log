        e.SPOUSE_NAME,
        e.FAMILY_INCOME,
        e.NO_SON,
        e.NO_DAUGHTER,
        e.P_POLICY_FLAG,
        e.POLICY_REF,
        e.PRPOSER_FLAG,
        e.PRPOSER_DTLS,
        e.UNIQUE_ID,
        e.OTHER_DETAILS,
        NULL AS VERSION,
