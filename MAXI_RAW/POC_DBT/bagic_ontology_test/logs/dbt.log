-- Link Policy to Partner
-- Connects hub_plcy (via CONTRACT_ID) to hub_prtnr_mstr
-- Sources: OPUS (OCP_INTERESTED_PARTIES) — MAXIMUS policy-partner link from stg_partner_detail

WITH opus_source AS (
    SELECT
        PART_ID,
        CONTRACT_ID,
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(PART_ID AS VARCHAR), ''))))
    
 AS hk_prtnr_mstr_cd,
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(CONTRACT_ID AS VARCHAR), ''))))
    
 AS hk_plcy_cd,
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(CONTRACT_ID AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(PART_ID AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_lnk_plcy_prtnr,
        load_dt_tm AS ld_dt_tm,
        record_source AS rcrd_src_nm
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_ocp_interested_parties
),



new_records AS (
    SELECT DISTINCT
        hk_lnk_plcy_prtnr,
        hk_plcy_cd,
        hk_prtnr_mstr_cd,
        ld_dt_tm,
        rcrd_src_nm
    FROM opus_source
    
)

SELECT * FROM new_records
        );
