create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_hsptl_infra_dtls
         as
        (

-- Satellite Partner Hospital Infrastructure Details
-- Hub: hub_prtnr_role (hospital infra attributes per role)
-- Source: SIMPLE_PROPERTY_PIVOT + MULTI_SET_PROPERTY
-- Domain: Hospital beds, ICU, wards, surgery, NABH, provider details

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

multi_set AS (
    SELECT
        PARTY_CODE,
        STAKE_CODE,
        hk_prtnr_role_cd,
        TYPE_OF_PARTY,
        PARTY_STATUS
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        h.prty_id AS PARTY_CODE,
        h.stake_cd AS STAKE_CODE,

        -- Semantic reference columns
        ms.TYPE_OF_PARTY AS partner_type,
        ms.PARTY_STATUS AS status,

        -- Hospital classification
        sp.HOSPITAL_NAME,
        sp.HOSPITAL_TYPE,
        sp.HOSPITAL_CATEGORY,
        sp.HOSPITAL_REGISTRATION_NUMBER,

        -- Bed / ICU / Ward capacity
        sp.BED_COUNT,
        sp.BED_STRENGTH,
        sp.ICU_BEDS,
        sp.ICU_AVAILABLE,
        sp.WARD_TYPE,
        sp.WARD_CATEGORY,

        -- Surgery / Specialization
        sp.SURGERY_FACILITY,
        sp.SURGERY_TYPE,
        sp.SPECIALIZATION,

        -- Accreditation
        sp.NABH_ACCREDITED,
        sp.NABH_ACCREDITATION_DATE,
        sp.NABH_VALIDITY,

        -- Provider network
        sp.PROVIDER_TYPE,
        sp.PROVIDER_CATEGORY,
        sp.PROVIDER_NETWORK,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.HOSPITAL_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.HOSPITAL_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BED_COUNT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.ICU_BEDS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.NABH_ACCREDITED AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PROVIDER_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PROVIDER_NETWORK AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SURGERY_FACILITY AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_role h
    INNER JOIN multi_set ms 
        ON h.prty_id = ms.PARTY_CODE 
        AND h.stake_cd = ms.STAKE_CODE
    LEFT JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON h.prty_id = sp.PARTY_CODE
)



