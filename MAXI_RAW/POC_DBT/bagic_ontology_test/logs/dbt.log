create or replace transient table BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_bnk_fnncl_dtls
         as
        (

-- Satellite Partner Bank Financial Details
-- Hub: hub_prtnr_role (financial details vary by partner role)
-- Source: MULTI_SET_PROPERTY_PIVOT (PROPERTY PARAM NAMES)
-- Domain: Bank accounts, payment methods, TDS, credit/mandate details

WITH party_detail AS (
    SELECT FOREIGN_KEY, PARTY_CODE, TYPE_OF_PARTY, PARTY_STATUS
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL
    WHERE PARTY_CODE IS NOT NULL
),

multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM party_detail pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(ms.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        ms.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        pd.TYPE_OF_PARTY AS partner_type,
        pd.PARTY_STATUS AS status,

        -- Bank account details (from PROPERTY PARAM NAMES in multi-set pivot)
        msp.ACCOUNT_HOLDER_NAME,
        msp.ACCOUNT_NUMBER,
        msp.ACCOUNT_TYPE,
        msp.BANK_ACCOUNT_NUMBER,
        msp.BANK_BRANCH_NAME AS BANK_BRANCH,
        msp.BANK_NAME AS BANK_CITY,
        msp.BANK_NAME,
        msp.IFSC AS IFSC_CODE,
        msp.MICR AS MICR_CODE,

        -- Payment details
        msp.PAYMENT_MODE,
        msp.PAYMENT_PLAN_TYPE AS PAYMENT_TYPE,
        msp.MANDATE_AMOUNT,
        msp.MANDATE_REGISTERED_ON AS MANDATE_DATE,
        msp.UMRN_NO AS MANDATE_NUMBER,
        msp.NEFT_STATUS AS MANDATE_STATUS,
        msp.MANDATE_TYPE,

        -- Credit / TDS
        msp.CREDIT_LIMIT,
        NULL AS CREDIT_PERIOD,
        CASE WHEN msp.TDS_RATE IS NOT NULL THEN 'Y' ELSE 'N' END AS TDS_APPLICABLE,
        msp.TDS_RATE AS TDS_PERCENTAGE,
        msp.TDS_SECTION_CODE AS TDS_SECTION,

        -- Metadata
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(msp.ACCOUNT_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.BANK_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.IFSC AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.MICR AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.PAYMENT_MODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.NEFT_STATUS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.CREDIT_LIMIT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.TDS_RATE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM multi_set ms
    INNER JOIN party_detail pd ON ms.PARTY_CODE = pd.PARTY_CODE
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 msp
        ON ms.FOREIGN_KEY = msp.FOREIGN_KEY
)



SELECT * FROM source


        );
