create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_emply_dtls
         as
        (

-- Satellite Partner Employee Details
-- Hub: hub_prtnr_role (employee-specific attributes per role)
-- Source: SIMPLE_PROPERTY_PIVOT + MULTI_SET_PROPERTY
-- Domain: Employee code, user details, acceptance/issue/submission dates

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

multi_set AS (
    SELECT
        PARTY_CODE,
        STAKE_CODE,
        hk_prtnr_role_cd,
        TYPE_OF_PARTY,
        PARTY_STATUS
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        h.prty_id AS PARTY_CODE,
        h.stake_cd AS STAKE_CODE,

        -- Semantic reference columns
        ms.TYPE_OF_PARTY AS partner_type,
        ms.PARTY_STATUS AS status,

        -- Employee identification
        sp.EMPLOYEE_CODE,
        sp.EMPLOYEE_ID,
        sp.EMPLOYEE_NAME,
        sp.EMPLOYEE_TYPE,
        sp.EMPLOYEE_STATUS,
        sp.EMPLOYEE_DESIGNATION,
        sp.EMPLOYEE_DEPARTMENT,

        -- User details
        sp.USER_ID,
        sp.USER_NAME,
        sp.USER_TYPE,
        sp.USER_STATUS,

        -- Key dates
        sp.DATE_OF_ACCEPTANCE,
        sp.DATE_OF_ISSUE,
        sp.DATE_OF_SUBMITTING,
        sp.DATE_OF_JOINING,
        sp.DATE_OF_LEAVING,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.EMPLOYEE_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EMPLOYEE_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EMPLOYEE_STATUS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EMPLOYEE_DESIGNATION AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.USER_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.DATE_OF_ACCEPTANCE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.DATE_OF_JOINING AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.DATE_OF_LEAVING AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_role h
    INNER JOIN multi_set ms 
        ON h.prty_id = ms.PARTY_CODE 
        AND h.stake_cd = ms.STAKE_CODE
    LEFT JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON h.prty_id = sp.PARTY_CODE
)



