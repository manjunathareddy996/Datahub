-- Satellite Partner Qualification Training Details
-- Hub: hub_prtnr_role (qualification/training per role)
-- Source: stg_partner_multiset_property
-- Domain: Qualifications, training, previous company, certificates

WITH hub_role AS (
    SELECT hk_prtnr_role_cd, prty_id, stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        msp.PARTY_CODE,
        msp.STAKE_CODE,

        -- Semantic reference columns
        msp.TYPE_OF_PARTY AS partner_type,
        msp.PARTY_STATUS AS status,

        -- Qualification details
        msp.QUALIFICATION_DETAILS AS QUALIFICATION,
        NULL AS QUALIFICATION_TYPE,
        msp.QUALIFICATION_DETAILS,
        msp.HIGHEST_QUALIFICATION_DETAILS AS HIGHEST_QUALIFICATION,
        msp.PROFESSIONAL_QUALIFICATION,

        -- Training details
        msp.TRAINING_IS_REQUIRED_TO_BE_GIVEN_TO_THE_EMPLOYEES_OF_THE_SERVICE_PROVIDER AS TRAINING_COMPLETED,
        NULL AS TRAINING_DATE,
        NULL AS TRAINING_TYPE,
        NULL AS TRAINING_CERTIFICATE_NUMBER,
        NULL AS TRAINING_VALID_TILL,

        -- Previous company
        msp.PREVIOUS_COMPANY_NAME,
        NULL AS PREVIOUS_COMPANY_CODE,
        msp.OVERALL_EXPERIENCE AS PREVIOUS_EXPERIENCE,

        -- Certificates
        msp.CERTIFICATION_NO AS CERTIFICATE_NUMBER,
        NULL AS CERTIFICATE_DATE,
        NULL AS CERTIFICATE_VALID_TILL,

        -- Metadata
        msp.load_dt_tm AS ld_dt_tm,
        msp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(msp.QUALIFICATION_DETAILS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.HIGHEST_QUALIFICATION_DETAILS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.PROFESSIONAL_QUALIFICATION AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.PREVIOUS_COMPANY_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.OVERALL_EXPERIENCE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.CERTIFICATION_NO AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property msp
    INNER JOIN hub_role h
        ON msp.PARTY_CODE = h.prty_id
        AND msp.STAKE_CODE = h.stake_cd
)



SELECT * FROM source


        );
