create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_clm
         as
        (

-- Hub Claim: One row per unique claim
-- Business Key: CLAIM_NUMBER (from health_claim.json → CLAIMNO / claim_details.POLICYNO context)
-- Sources: MAXIMUS Health Claim

WITH source AS (
    SELECT DISTINCT
        CLAIMNO,
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(CLAIMNO AS VARCHAR), ''))))
    
 AS hk_clm_cd,
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_trvl_clm_nonhlth_trv_clm_vw_data_clm_details
    WHERE CLAIMNO IS NOT NULL
),



new_records AS (
    SELECT
        hk_clm_cd,
        CLAIMNO AS clm_nbr,
        ld_dt_tm,
        rcrd_src_nm
    FROM source
    
)

SELECT * FROM new_records
        );
