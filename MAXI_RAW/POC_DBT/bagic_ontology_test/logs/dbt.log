create or replace  temporary view BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_kyc_id_dtls__dbt_tmp
  
   as (
    

-- Satellite Partner KYC Identification Details
-- Hub: hub_prtnr_mstr (identity documents are person-level)
-- Source: SIMPLE_PROPERTY_PIVOT

WITH source AS (
    SELECT
        hk_prtnr_mstr_cd,
        PARTY_CODE,
        
        -- KYC attributes from simple property pivot
        AADHAR_NO,
        AADHAAR_ENROLLMENT_NO,
        AADHAAR_NUMBER,
        ABHA_ID,
        AML_VERIFICATION_STATUS,
        CIN_NUMBER,
        CKYC_DETAILS,
        CKYC_NUMBER,
        CKYC_STATUS,
        CLAIM_AML_VERIFICATION_STATUS,
        CLAIM_CKYC_DETAILS,
        CLAIM_CKYC_NUMBER,
        CLAIM_CKYC_STATUS,
        CLAIM_POA_STATUS,
        CLAIM_POI_STATUS,
        DO_YOU_HAVE_CKYC_NUMBER,
        DRIVING_LICENSE_DETAILS,
        DRIVING_LICENSE_EXPERIENCE,
        DRIVING_LICENSE_EXPIRY_DATE,
        DRIVING_LICENSE_ISSUE_DATE,
        DRIVING_LICENSE_NUMBER,
        DRIVING_LICENSE_PLACE_OF_ISSUE,
        EIA_AVAILABLE,
        EIA_CREDIT_REQUIRED,
        EIA_DETAILS,
        EIA_NUMBER,
        EIA_REQUIRED,
        EIA_WHEN_LINKED,
        E_INSURANCE_DEMAT_ACCOUNT_VERIFIED,
        ID_NUMBER,
        ID_PROOF,
        ID_TYPE,
        ID_TYPE1,
        IDENTIFICATION_PROOF,
        IDENTIFICATION_PROOF_EFFECTIVE_DATE,
        INSURANCE_REPOSITORY_CODE,
        INVESTIGATORS_PAN_NO,
        KYC_DETAILS,
        KYC_RELATED_DETAILS,
        NAME_AS_PER_AADHAAR,
        NAME_AS_PER_CKYC,
        NAME_AS_PER_PAN,
        NAME_AS_PER_PAN_NUMBER,
        NREGA_JOB_CARD,
        PAN_AADHAAR_LINKED,
        PAN_APPLICATION_NO,
        PAN_APPLIED_FOR,
        PAN_NO,
        PAN_NUMBER,
        PASSPORT_DETAILS,
        PASSPORT_FILE_NO,
        PASSPORT_NUMBER,
        POA_AADHAR_CARD_STATUS,
        POA_DOCUMENT_STATUS,
        POA_DRIVING_LICENSE_STATUS,
        POA_NREGA_JOB_CARD_STATUS,
        POA_PASSPORT_STATUS,
        POA_STATUS,
        POI_DOCUMENT_STATUS,
        POI_FORM_60_STATUS,
        POI_PAN_CARD_STATUS,
        POI_STATUS,
        UID,
        VID,
        VOTER_ID,
        
        -- Metadata
        load_dt_tm AS ld_dt_tm,
        record_source AS rcrd_src_nm,
        
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(AADHAAR_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(PAN_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(CKYC_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(CKYC_STATUS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(PASSPORT_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(VOTER_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(DRIVING_LICENSE_NUMBER AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
        
    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property
)


, existing AS (
    SELECT hk_prtnr_mstr_cd, rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_kyc_id_dtls
    QUALIFY ROW_NUMBER() OVER (PARTITION BY hk_prtnr_mstr_cd ORDER BY ld_dt_tm DESC) = 1
)

SELECT s.*
FROM source s
LEFT JOIN existing e ON s.hk_prtnr_mstr_cd = e.hk_prtnr_mstr_cd
WHERE e.hk_prtnr_mstr_cd IS NULL
