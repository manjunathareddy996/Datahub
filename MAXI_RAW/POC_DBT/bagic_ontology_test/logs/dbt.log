        CURRENT_PERMANENT_OVERSEAS_ADDRESS_CITY_TOWN_VILLAGE AS crnt_prmnt_ovrseas_addrs_city,
        CURRENT_PERMANENT_OVERSEAS_ADDRESS_COUNTRY AS crnt_prmnt_ovrseas_addrs_country,
