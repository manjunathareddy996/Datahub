create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_prfl_misc_dtls
         as
        (

-- Satellite Partner Profile Miscellaneous Details
-- Hub: hub_prtnr_role (catch-all for remaining profile attributes)
-- Sources: MAXIMUS (simple property) + OPUS (AZBJ_PARTNER_EXTN, BJAZ_AZBJ_PART_EXT_HIST,
--          BJAZ_CP_PART_HIST, CLM_INTERESTED_PARTIES, OCP_INTERESTED_PARTIES)
-- Per OPUS_MAPPING_FINAL: 69 OPUS columns land here

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

hub_mstr AS (
    SELECT 
        hk_prtnr_mstr_cd,
        prty_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_mstr
),

multi_set AS (
    SELECT
        PARTY_CODE,
        STAKE_CODE,
        hk_prtnr_role_cd,
        TYPE_OF_PARTY,
        PARTY_STATUS
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property
),

maximus_source AS (
    SELECT
        h.hk_prtnr_role_cd,
        h.prty_id AS PARTY_CODE,
        h.stake_cd AS STAKE_CODE,

        -- Semantic reference columns
        ms.TYPE_OF_PARTY AS partner_type,
        ms.PARTY_STATUS AS status,

        -- Profile miscellaneous
        sp.REMARKS,
        NULL AS COMMENTS,
        NULL AS NOTES,
        NULL AS DESCRIPTION,
        sp.REFERENCE_CODE AS REFERENCE_NUMBER,
        NULL AS REFERENCE_TYPE,

        -- Classification
        sp.CATEGORY,
        NULL AS SUB_CATEGORY,
        NULL AS CLASS,
        NULL AS GRADE,
        sp.RATING,

        -- Flags / Indicators
        NULL AS ACTIVE_FLAG,
        NULL AS VERIFIED_FLAG,
        NULL AS APPROVED_FLAG,
        NULL AS PRIORITY,

        -- Dates
        sp.EFFECTIVE_DATE,
        sp.EXPIRY_DATE,
        NULL AS LAST_UPDATED_DATE,
        NULL AS REVIEW_DATE,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.REMARKS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.CATEGORY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.RATING AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EFFECTIVE_DATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EXPIRY_DATE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_role h
    INNER JOIN multi_set ms 
        ON h.prty_id = ms.PARTY_CODE 
        AND h.stake_cd = ms.STAKE_CODE
    LEFT JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON h.prty_id = sp.PARTY_CODE
),

opus_partner_extn AS (
    SELECT
        hm.hk_prtnr_mstr_cd AS hk_prtnr_role_cd,
        ope.load_dt_tm AS ld_dt_tm,
        ope.record_source AS rcrd_src_nm,
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(ope.PARENT_CO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.INDUSTRY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.PLACE_OF_BIRTH AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.PA_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.UCIC_FLAG AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.HNI_FLAG AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.MSME_FLAG AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.VIP_CUST AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_partner_extn ope
    INNER JOIN hub_mstr hm 
        ON hm.prty_id = CAST(ope.PART_ID AS VARCHAR)
),

opus_partner_extn_hist AS (
    SELECT
        hm.hk_prtnr_mstr_cd AS hk_prtnr_role_cd,
        opeh.load_dt_tm AS ld_dt_tm,
        opeh.record_source AS rcrd_src_nm,
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(opeh.PA_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(opeh.SUBCODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(opeh.AVAILABILITY_TIME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(opeh.INDUSTRY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(opeh.PLACE_OF_BIRTH AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(opeh.VIP_CUST AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_partner_extn_hist opeh
    INNER JOIN hub_mstr hm 
        ON hm.prty_id = CAST(opeh.PART_ID AS VARCHAR)
),

opus_partner_hist AS (
    SELECT
        hm.hk_prtnr_mstr_cd AS hk_prtnr_role_cd,
        oph.load_dt_tm AS ld_dt_tm,
        oph.record_source AS rcrd_src_nm,
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(oph.CAUSE_OF_DEATH AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(oph.DNI AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(oph.LUA_VALUE_1 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(oph.LUA_VALUE_2 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(oph.TAX_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(oph.VAT_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(oph.NATIONAL_ID AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_partner_hist oph
    INNER JOIN hub_mstr hm 
        ON hm.prty_id = CAST(oph.PART_ID AS VARCHAR)
),

opus_clm_ip AS (
    SELECT
        hm.hk_prtnr_mstr_cd AS hk_prtnr_role_cd,
        ocip.load_dt_tm AS ld_dt_tm,
        ocip.record_source AS rcrd_src_nm,
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(ocip.CLAIM_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ocip.IP_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ocip.IP_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ocip.CLAIMANT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ocip.OBJECT_TYPE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_clm_interested_parties ocip
    INNER JOIN hub_mstr hm 
        ON hm.prty_id = CAST(ocip.PART_ID AS VARCHAR)
),

opus_ocp_ip AS (
    SELECT
        hm.hk_prtnr_mstr_cd AS hk_prtnr_role_cd,
        ooip.load_dt_tm AS ld_dt_tm,
        ooip.record_source AS rcrd_src_nm,
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(ooip.PART_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ooip.IP_NO AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_ocp_interested_parties ooip
    INNER JOIN hub_mstr hm 
        ON hm.prty_id = CAST(ooip.PART_ID AS VARCHAR)
),

combined AS (
    SELECT * FROM maximus_source
    UNION ALL
    SELECT * FROM opus_partner_extn
    UNION ALL
    SELECT * FROM opus_partner_extn_hist
    UNION ALL
    SELECT * FROM opus_partner_hist
    UNION ALL
    SELECT * FROM opus_clm_ip
    UNION ALL
    SELECT * FROM opus_ocp_ip
)



SELECT * FROM combined


        );
