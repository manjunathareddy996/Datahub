create or replace   view BAGIC_PREPROD_CURATED_DB.UTILS.raw_sat_prtnr_addrs_dtls
  
   as (
    WITH v_simple_property AS (
    SELECT *
    FROM BAGIC_PROD_MIRRO_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_SIMPLE_PROPERTY
    WHERE DATE(INC_JOB_CREATED_AT) >= 
    
    
        '2026-02-20'
    

),

v_address_property AS (
    SELECT *
    FROM BAGIC_PROD_MIRRO_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_ADDRESS_ADDRESS_PROPERTY
    WHERE DATE(INC_JOB_CREATED_AT) >= 
    
    
        '2026-02-20'
    

),

v_simple_pivot AS (
    SELECT
        FOREIGN_KEY AS part_id,
        MAX(CASE WHEN PARAM_NAME = 'LOCATION_CODE' THEN PARAM_VALUE END) AS location_cd,
        MAX(CASE WHEN PARAM_NAME = 'ADDRESSEE' THEN PARAM_VALUE END) AS addressee,
        MAX(CASE WHEN PARAM_NAME = 'ADDRESS_OF_THE_COORDINATING_OFFICE' THEN PARAM_VALUE END) AS addrs_of_coordinating_office,
        MAX(CASE WHEN PARAM_NAME = 'CURRENT_PERMANENT_OVERSEAS_ADDRESS_STATE_UT' THEN PARAM_VALUE END) AS crnt_prmnt_ovrseas_addrs_state_ut,
        MAX(CASE WHEN PARAM_NAME = 'IS_THE_MAILINGCOMMUNICATION_ADDRESS_SAME_AS_THE_PRIMARY_ADDRESS' THEN PARAM_VALUE END) AS is_mailing_addrs_same_as_primary,
        MAX(CASE WHEN PARAM_NAME = 'ADDRESS_PROOF' THEN PARAM_VALUE END) AS addrs_proof,
        MAX(CASE WHEN PARAM_NAME = 'ADDRESS_PROOF_EFFECTIVE_DATE' THEN PARAM_VALUE END) AS addrs_proof_effective_dt,
        MAX(CASE WHEN PARAM_NAME = 'CORRESPONDENCE_LOCAL_ADDRESS_CITY_TOWN_VILLAGE' THEN PARAM_VALUE END) AS corr_local_addrs_city,
        MAX(CASE WHEN PARAM_NAME = 'CORRESPONDENCE_LOCAL_ADDRESS_COUNTRY' THEN PARAM_VALUE END) AS corr_local_addrs_country,
        MAX(CASE WHEN PARAM_NAME = 'CORRESPONDENCE_LOCAL_ADDRESS_DISTRICT' THEN PARAM_VALUE END) AS corr_local_addrs_district,
        MAX(CASE WHEN PARAM_NAME = 'CORRESPONDENCE_LOCAL_ADDRESS_LINE_1' THEN PARAM_VALUE END) AS corr_local_addrs_line_1,
        MAX(CASE WHEN PARAM_NAME = 'CORRESPONDENCE_LOCAL_ADDRESS_LINE_2' THEN PARAM_VALUE END) AS corr_local_addrs_line_2,
        MAX(CASE WHEN PARAM_NAME = 'CORRESPONDENCE_LOCAL_ADDRESS_LINE_3' THEN PARAM_VALUE END) AS corr_local_addrs_line_3,
        MAX(CASE WHEN PARAM_NAME = 'CORRESPONDENCE_LOCAL_ADDRESS_STATE' THEN PARAM_VALUE END) AS corr_local_addrs_state,
        MAX(CASE WHEN PARAM_NAME = 'COUNTRY' THEN PARAM_VALUE END) AS country,
        MAX(CASE WHEN PARAM_NAME = 'COVERED_AREA_IN_KMS' THEN PARAM_VALUE END) AS covered_area_in_kms,
