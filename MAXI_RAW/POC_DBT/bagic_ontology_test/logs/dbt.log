         as
        (

-- Satellite Partner KYC Identification Details
-- Hub: hub_prtnr_mstr (identity documents are person-level)
-- Source: SIMPLE_PROPERTY_PIVOT

WITH hub_mstr AS (
    SELECT 
        hk_prtnr_mstr_cd,
        prty_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_mstr
),

source AS (
    SELECT
        h.hk_prtnr_mstr_cd,
        h.prty_id AS PARTY_CODE,
        
        -- KYC attributes from simple property pivot
        sp.AADHAR_NO,
        sp.AADHAAR_ENROLLMENT_NO,
        sp.AADHAAR_NUMBER,
        sp.ABHA_ID,
        sp.AML_VERIFICATION_STATUS,
        sp.CIN_NUMBER,
        sp.CKYC_DETAILS,
        sp.CKYC_NUMBER,
        sp.CKYC_STATUS,
        sp.CLAIM_AML_VERIFICATION_STATUS,
        sp.CLAIM_CKYC_DETAILS,
        sp.CLAIM_CKYC_NUMBER,
        sp.CLAIM_CKYC_STATUS,
        sp.CLAIM_POA_STATUS,
        sp.CLAIM_POI_STATUS,
        sp.DO_YOU_HAVE_CKYC_NUMBER,
        sp.DRIVING_LICENSE_DETAILS,
        sp.DRIVING_LICENSE_EXPERIENCE,
        sp.DRIVING_LICENSE_EXPIRY_DATE,
        sp.DRIVING_LICENSE_ISSUE_DATE,
        sp.DRIVING_LICENSE_NUMBER,
        sp.DRIVING_LICENSE_PLACE_OF_ISSUE,
        sp.EIA_AVAILABLE,
        sp.EIA_CREDIT_REQUIRED,
        sp.EIA_DETAILS,
        sp.EIA_NUMBER,
        sp.EIA_REQUIRED,
        sp.EIA_WHEN_LINKED,
        sp.E_INSURANCE_DEMAT_ACCOUNT_VERIFIED,
        sp.ID_NUMBER,
        sp.ID_PROOF,
        sp.ID_TYPE,
        sp.ID_TYPE1,
        sp.IDENTIFICATION_PROOF,
        sp.IDENTIFICATION_PROOF_EFFECTIVE_DATE,
        sp.INSURANCE_REPOSITORY_CODE,
        sp.INVESTIGATORS_PAN_NO,
        sp.KYC_DETAILS,
        sp.KYC_RELATED_DETAILS,
        sp.NAME_AS_PER_AADHAAR,
        sp.NAME_AS_PER_CKYC,
        sp.NAME_AS_PER_PAN,
        sp.NAME_AS_PER_PAN_NUMBER,
        sp.NREGA_JOB_CARD,
        sp.PAN_AADHAAR_LINKED,
        sp.PAN_APPLICATION_NO,
        sp.PAN_APPLIED_FOR,
        sp.PAN_NO,
        sp.PAN_NUMBER,
        sp.PASSPORT_DETAILS,
        sp.PASSPORT_FILE_NO,
        sp.PASSPORT_NUMBER,
        sp.POA_AADHAR_CARD_STATUS,
        sp.POA_DOCUMENT_STATUS,
        sp.POA_DRIVING_LICENSE_STATUS,
        sp.POA_NREGA_JOB_CARD_STATUS,
        sp.POA_PASSPORT_STATUS,
        sp.POA_STATUS,
        sp.POI_DOCUMENT_STATUS,
        sp.POI_FORM_60_STATUS,
        sp.POI_PAN_CARD_STATUS,
        sp.POI_STATUS,
        sp.UID,
        sp.VID,
        sp.VOTER_ID,
        
        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,
        
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.AADHAAR_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PAN_NUMBER AS VARCHAR), '')))
