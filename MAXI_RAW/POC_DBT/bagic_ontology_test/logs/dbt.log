create or replace transient table BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_dlr_rprr_dtls
         as
        (

-- Satellite Partner Dealer Repairer Details
-- Hub: hub_prtnr_role (dealer/repairer attributes per role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Dealer, repairer, automobile, labor rate, cash back

WITH multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

        -- Dealer details
        sp.DEALER_CODE,
        NULL AS DEALER_NAME,
        sp.DEALER_TYPE,
        NULL DEALER_CATEGORY,
        NULL DEALER_MAKE,

        -- Repairer details
        sp.REPAIRER_PORTAL_ID AS REPAIRER_CODE,
        NULL AS REPAIRER_NAME,
        NULL AS REPAIRER_TYPE,
        NULL AS REPAIRER_CATEGORY,

        -- Automobile
        NULL AS AUTOMOBILE_MAKE,
        NULL AS AUTOMOBILE_MODEL,
        NULL AS AUTOMOBILE_TYPE,

        -- Rates / Financials
        sp.LABOR_RATE,
        NULL AS LABOR_RATE_PER_HOUR,
        NULL AS CASH_BACK_PERCENTAGE,
        NULL AS CASH_BACK_AMOUNT,
        NULL AS CASH_BACK_APPLICABLE,
        sp.CASH_BACK_OFFER,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.DEALER_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.DEALER_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.REPAIRER_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.LABOR_RATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.CASH_BACK_OFFER AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)



SELECT * FROM source


        );
