create or replace   view BAGIC_PREPROD_CURATED_DB.UTILS.raw_sat_prtnr_addrs_dtls
  
   as (
    WITH v_simple_property AS (
    SELECT *
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_SIMPLE_PROPERTY
    WHERE DATE(INC_JOB_CREATED_AT) >= 
    
    
        '2026-02-20'
    

),

v_address_property AS (
    SELECT *
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_ADDRESS_ADDRESS_PROPERTY
    WHERE DATE(INC_JOB_CREATED_AT) >= 
    
    
        '2026-02-20'
    

),

v_simple_pivot AS (
    SELECT
        FOREIGN_KEY AS part_id,
        MAX(CASE WHEN PARAM_NAME = 'Location Code' THEN PARAM_VALUE END) AS location_cd,
        MAX(CASE WHEN PARAM_NAME = 'Location code' THEN PARAM_VALUE END) AS location_cd_alt,
        MAX(CASE WHEN PARAM_NAME = 'Addressee' THEN PARAM_VALUE END) AS addressee,
        MAX(CASE WHEN PARAM_NAME = 'Address of the coordinating Office' THEN PARAM_VALUE END) AS addrs_of_coordinating_office,
        MAX(CASE WHEN PARAM_NAME = 'Current Permanent Overseas Address State U.T' THEN PARAM_VALUE END) AS crnt_prmnt_ovrseas_addrs_state_ut,
        MAX(CASE WHEN PARAM_NAME = 'Is The Mailing/Communication Address Same As The Primary Address?' THEN PARAM_VALUE END) AS is_mailing_addrs_same_as_primary,
        MAX(CASE WHEN PARAM_NAME = 'Address Proof' THEN PARAM_VALUE END) AS addrs_proof,
        MAX(CASE WHEN PARAM_NAME = 'Address Proof Effective Date' THEN PARAM_VALUE END) AS addrs_proof_effective_dt,
        MAX(CASE WHEN PARAM_NAME = 'Correspondence Local Address City Town Village' THEN PARAM_VALUE END) AS corr_local_addrs_city,
        MAX(CASE WHEN PARAM_NAME = 'Correspondence Local Address Country' THEN PARAM_VALUE END) AS corr_local_addrs_country,
        MAX(CASE WHEN PARAM_NAME = 'Correspondence Local Address District' THEN PARAM_VALUE END) AS corr_local_addrs_district,
        MAX(CASE WHEN PARAM_NAME = 'Correspondence Local Address Line 1' THEN PARAM_VALUE END) AS corr_local_addrs_line_1,
        MAX(CASE WHEN PARAM_NAME = 'Correspondence Local Address Line 2' THEN PARAM_VALUE END) AS corr_local_addrs_line_2,
        MAX(CASE WHEN PARAM_NAME = 'Correspondence Local Address Line 3' THEN PARAM_VALUE END) AS corr_local_addrs_line_3,
        MAX(CASE WHEN PARAM_NAME = 'Correspondence Local Address State' THEN PARAM_VALUE END) AS corr_local_addrs_state,
        MAX(CASE WHEN PARAM_NAME = 'Country' THEN PARAM_VALUE END) AS country,
        MAX(CASE WHEN PARAM_NAME = 'Covered Area In Kms' THEN PARAM_VALUE END) AS covered_area_in_kms,
        MAX(CASE WHEN PARAM_NAME = 'Current Permanent Overseas Address ' THEN PARAM_VALUE END) AS crnt_prmnt_ovrseas_addrs,
        MAX(CASE WHEN PARAM_NAME = 'Current Permanent Overseas Address City Town Village' THEN PARAM_VALUE END) AS crnt_prmnt_ovrseas_addrs_city,
        MAX(CASE WHEN PARAM_NAME = 'Current Permanent Overseas Address Country' THEN PARAM_VALUE END) AS crnt_prmnt_ovrseas_addrs_country,
        MAX(CASE WHEN PARAM_NAME = 'Current Permanent Overseas Address Line 1' THEN PARAM_VALUE END) AS crnt_prmnt_ovrseas_addrs_line_1,
        MAX(CASE WHEN PARAM_NAME = 'Current Permanent Overseas Address Line 2' THEN PARAM_VALUE END) AS crnt_prmnt_ovrseas_addrs_line_2,
        MAX(CASE WHEN PARAM_NAME = 'Current Permanent Overseas Address Line 3' THEN PARAM_VALUE END) AS crnt_prmnt_ovrseas_addrs_line_3,
        MAX(CASE WHEN PARAM_NAME = 'Current Permanent Overseas Address PIN Code' THEN PARAM_VALUE END) AS crnt_prmnt_ovrseas_addrs_pin_cd,
        MAX(CASE WHEN PARAM_NAME = 'Current Permanent Overseas Address Type' THEN PARAM_VALUE END) AS crnt_prmnt_ovrseas_addrs_type,
        MAX(CASE WHEN PARAM_NAME = 'Flag indicating if Current Permanent Overseas Address is same as correspondence local Address' THEN PARAM_VALUE END) AS flg_ovrseas_same_as_corr,
        MAX(CASE WHEN PARAM_NAME = 'Latitude' THEN PARAM_VALUE END) AS latitude,
        MAX(CASE WHEN PARAM_NAME = 'Local Address PIN Code' THEN PARAM_VALUE END) AS local_addrs_pin_cd,
        MAX(CASE WHEN PARAM_NAME = 'Location' THEN PARAM_VALUE END) AS location,
        MAX(CASE WHEN PARAM_NAME = 'Longitude' THEN PARAM_VALUE END) AS longitude
    FROM v_simple_property
    GROUP BY FOREIGN_KEY
),

v_address_pivot AS (
    SELECT
        FOREIGN_KEY AS part_id,
        MAX(CASE WHEN PARAM_NAME = 'GEO_COORDINATE_ALTITUDE' THEN PARAM_VALUE END) AS geo_coord_altitude,
        MAX(CASE WHEN PARAM_NAME = 'GEO_COORDINATE_LATITUDE' THEN PARAM_VALUE END) AS geo_coord_latitude,
        MAX(CASE WHEN PARAM_NAME = 'GEO_COORDINATE_LONGITUDE' THEN PARAM_VALUE END) AS geo_coord_longitude,
        MAX(CASE WHEN PARAM_NAME = 'AREA' THEN PARAM_VALUE END) AS area,
        MAX(CASE WHEN PARAM_NAME = 'CITY' THEN PARAM_VALUE END) AS city,
        MAX(CASE WHEN PARAM_NAME = 'LAND_MARK' THEN PARAM_VALUE END) AS land_mark,
        MAX(CASE WHEN PARAM_NAME = 'LOCATION_TYPE' THEN PARAM_VALUE END) AS location_type,
        MAX(CASE WHEN PARAM_NAME = 'PINCODE' THEN PARAM_VALUE END) AS pincode,
        MAX(CASE WHEN PARAM_NAME = 'POST_OFFICE' THEN PARAM_VALUE END) AS post_office,
        MAX(CASE WHEN PARAM_NAME = 'STATE' THEN PARAM_VALUE END) AS state
    FROM v_address_property
    GROUP BY FOREIGN_KEY
),

v_final AS (
    SELECT
        sp.part_id,
        COALESCE(sp.location_cd, sp.location_cd_alt) AS location_cd,
        sp.addressee,
        sp.addrs_of_coordinating_office,
        sp.crnt_prmnt_ovrseas_addrs_state_ut,
        sp.is_mailing_addrs_same_as_primary,
        sp.addrs_proof,
        sp.addrs_proof_effective_dt,
        sp.corr_local_addrs_city,
        sp.corr_local_addrs_country,
        sp.corr_local_addrs_district,
        sp.corr_local_addrs_line_1,
        sp.corr_local_addrs_line_2,
        sp.corr_local_addrs_line_3,
        sp.corr_local_addrs_state,
        sp.country,
        sp.covered_area_in_kms,
        sp.crnt_prmnt_ovrseas_addrs,
        sp.crnt_prmnt_ovrseas_addrs_city,
        sp.crnt_prmnt_ovrseas_addrs_country,
        sp.crnt_prmnt_ovrseas_addrs_line_1,
        sp.crnt_prmnt_ovrseas_addrs_line_2,
        sp.crnt_prmnt_ovrseas_addrs_line_3,
        sp.crnt_prmnt_ovrseas_addrs_pin_cd,
        sp.crnt_prmnt_ovrseas_addrs_type,
        sp.flg_ovrseas_same_as_corr,
        sp.latitude,
        sp.local_addrs_pin_cd,
        sp.location,
        sp.longitude,
        ap.geo_coord_altitude,
        ap.geo_coord_latitude,
        ap.geo_coord_longitude,
        ap.area,
        ap.city,
        ap.land_mark,
        ap.location_type,
        ap.pincode,
        ap.post_office,
        ap.state,
        'MAXIMUS' AS rcrd_src_nm
    FROM v_simple_pivot sp
    LEFT JOIN v_address_pivot ap
        ON sp.part_id = ap.part_id
)

SELECT * FROM v_final
  );
