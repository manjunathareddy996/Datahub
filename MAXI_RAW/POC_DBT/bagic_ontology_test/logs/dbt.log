create or replace  temporary view BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_hsptl_mou_stts_dtls__dbt_tmp
  
   as (
    

-- Satellite Partner Hospital MOU Status Details
-- Hub: hub_prtnr_role (MOU/agreement status per hospital role)
-- Source: SIMPLE_PROPERTY_PIVOT + MULTI_SET_PROPERTY
-- Domain: MOU, blacklist, suspension, discount, tariff, advance details

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

multi_set AS (
    SELECT
        PARTY_CODE,
        STAKE_CODE,
        hk_prtnr_role_cd,
        TYPE_OF_PARTY,
        PARTY_STATUS
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        h.prty_id AS PARTY_CODE,
        h.stake_cd AS STAKE_CODE,

        -- Semantic reference columns
        ms.TYPE_OF_PARTY AS partner_type,
        ms.PARTY_STATUS AS status,

        -- MOU details
        sp.MOU_STATUS,
        sp.MOU_VALIDITY_START_DATE AS MOU_START_DATE,
        sp.MOU_VALIDITY_END_DATE AS MOU_END_DATE,
        NULL AS MOU_RENEWAL_DATE,
        sp.TYPE_OF_MOU AS MOU_TYPE,
        NULL AS MOU_SIGNED_DATE,

        -- Blacklist / Suspension
        sp.BLACKLISTED AS BLACKLIST_STATUS,
        sp.REASON_BLACKLISTED AS BLACKLIST_REASON,
        sp.DATE_OF_BLACKLISTING AS BLACKLIST_DATE,
        sp.SUSPENDED AS SUSPENDED_STATUS,
        sp.SUSPENDED_REASON,
        sp.SUSPENDED_EFFECTIVE_DATE AS SUSPENDED_DATE,

        -- Discount / Tariff
        sp.DISCOUNT_PERCENTAGE,
        sp.DISCOUNT_TYPE,
        sp.SPECIAL_TARIFF AS TARIFF_TYPE,
        NULL AS TARIFF_CATEGORY,

        -- Advance
        sp.ADVANCE_AMOUNT,
        sp.ADVANCE_PAYMENT_APPLICABLE AS ADVANCE_STATUS,
        sp.ADVANCE_PAYMENT_START_DATE AS ADVANCE_DATE,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.MOU_STATUS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MOU_VALIDITY_START_DATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MOU_VALIDITY_END_DATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BLACKLISTED AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SUSPENDED AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.DISCOUNT_PERCENTAGE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SPECIAL_TARIFF AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.ADVANCE_PAYMENT_APPLICABLE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_role h
    INNER JOIN multi_set ms 
        ON h.prty_id = ms.PARTY_CODE 
        AND h.stake_cd = ms.STAKE_CODE
    LEFT JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON h.prty_id = sp.PARTY_CODE
)



SELECT s.*
FROM source s
LEFT JOIN (
    SELECT hk_prtnr_role_cd, rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_hsptl_mou_stts_dtls
    QUALIFY ROW_NUMBER() OVER (PARTITION BY hk_prtnr_role_cd ORDER BY ld_dt_tm DESC) = 1
) e ON s.hk_prtnr_role_cd = e.hk_prtnr_role_cd
WHERE e.hk_prtnr_role_cd IS NULL
   OR s.rcrd_hsh_id != e.rcrd_hsh_id


  );
