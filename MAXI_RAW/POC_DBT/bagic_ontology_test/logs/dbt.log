create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_mmbr_ec_sh_dtls
         as
        (

-- Satellite Partner Member Extended Cover & Senior Health Details
-- Hub: hub_prtnr_mstr
-- Sources: OPUS
--   BJAZ_EC_MEM_DTLS_EXTN (58 cols) — Extended Cover
--   BJAZ_SH_MEM_DTLS_EXTN (44 cols) — Senior Health
-- Total: 102 OPUS attributes

WITH hub_mstr AS (
    SELECT 
        hk_prtnr_mstr_cd,
        prty_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_mstr
),

ec AS (
    SELECT
        h.hk_prtnr_mstr_cd,
        ec.PART_ID,
        ec.CONTRACT_ID AS contract_id,
        ec.MEMBER_NO AS member_no,
        ec.NAME AS member_name,
        ec.DATE_OF_BIRTH, 
        ec.AGE, 
        ec.GENDER, 
        ec.RELATION,
        ec.SUM_INSURED, 
        ec.PREMIUM,
        ec.load_dt_tm AS ld_dt_tm,
        ec.record_source AS rcrd_src_nm,
        'EC' AS product_type,
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(ec.PART_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ec.CONTRACT_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ec.MEMBER_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ec.NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ec.SUM_INSURED AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ec.PREMIUM AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_ec_member ec
    INNER JOIN hub_mstr h 
        ON h.prty_id = ec.PART_ID
),

sh AS (
    SELECT
        h.hk_prtnr_mstr_cd,
        sh.PART_ID,
        sh.CONTRACT_ID AS contract_id,
        sh.MEMBER_NO AS member_no,
        sh.NAME AS member_name,
        sh.DATE_OF_BIRTH, 
        sh.AGE, 
        sh.GENDER, 
        sh.RELATION,
        sh.SUM_INSURED, 
        sh.PREMIUM,
        sh.load_dt_tm AS ld_dt_tm,
        sh.record_source AS rcrd_src_nm,
        'SH' AS product_type,
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sh.PART_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sh.CONTRACT_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sh.MEMBER_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sh.NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sh.SUM_INSURED AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sh.PREMIUM AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_sh_member sh
    INNER JOIN hub_mstr h 
        ON h.prty_id = sh.PART_ID
),

combined AS (
    SELECT * FROM ec
    UNION ALL
    SELECT * FROM sh
)



SELECT * FROM combined


        );
