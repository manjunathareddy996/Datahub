        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

multi_set AS (
    SELECT
        PARTY_CODE,
        STAKE_CODE,
        hk_prtnr_role_cd,
        TYPE_OF_PARTY,
        PARTY_STATUS
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        h.prty_id AS PARTY_CODE,
        h.stake_cd AS STAKE_CODE,

        -- Semantic reference columns
        ms.TYPE_OF_PARTY AS partner_type,
        ms.PARTY_STATUS AS status,

        -- GST details
        NULL AS GST_APPLICABLE,
        sp.GSTINUIN AS GST_NUMBER,
        sp.GSTIN_ISSUANCE_DT AS GST_REGISTRATION_DATE,
        NULL AS GST_STATE,
        NULL AS GST_TYPE,
        sp.GSTINUIN AS GSTIN,
        sp.GSTN_NUMBER AS GSTIN_NUMBER,

        -- Statewise GSTIN
        sp.STATEWISE_GSTIN_DETAILS AS STATEWISE_GSTIN_1,
        NULL AS STATEWISE_GSTIN_2,
        NULL AS STATEWISE_GSTIN_3,
        NULL AS STATEWISE_GSTIN_STATE_1,
        NULL AS STATEWISE_GSTIN_STATE_2,

        -- Registration
        sp.REGISTRATION_NO AS REGISTRATION_NUMBER,
        sp.SEZ_REGISTRATION_DATE AS REGISTRATION_DATE,
        NULL AS REGISTRATION_VALID_TILL,
        NULL AS REGISTRATION_TYPE,

        -- Business details
        sp.BUSINESS_TYPE,
        NULL AS BUSINESS_CATEGORY,
        NULL AS BUSINESS_NATURE,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.GSTINUIN AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.GSTN_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.REGISTRATION_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SEZ_REGISTRATION_DATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BUSINESS_TYPE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_role h
    INNER JOIN multi_set ms 
        ON h.prty_id = ms.PARTY_CODE 
        AND h.stake_cd = ms.STAKE_CODE
    LEFT JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON h.prty_id = sp.PARTY_CODE
)


, existing AS (
