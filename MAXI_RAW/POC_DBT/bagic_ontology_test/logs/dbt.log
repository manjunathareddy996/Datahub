create or replace  temporary view BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_addrs_dtls__dbt_tmp
  
   as (
    

-- Satellite Partner Address Details
-- Hub: hub_prtnr_role (address can vary by role)
-- Source: PARTY_ADDRESS + ADDRESS_PROPERTY_PIVOT

WITH source AS (
    SELECT
        -- For role hub, we need PARTY_CODE + STAKE_CODE
        -- Address is linked via FOREIGN_KEY to party detail
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(PARTY_CODE AS VARCHAR), ''))))
    
 AS hk_prtnr_mstr_cd,
        PARTY_CODE,
        
        -- Address fields
        ADDRESS1,
        ADDRESS2,
        ADDRESS3,
        ADDRESS_TYPE,
        CITY,
        COUNTRY,
        DISTRICT,
        PINCODE,
        STATE,
        
        -- Address property pivot
        AREA,
        GEO_COORDINATE_ALTITUDE,
        GEO_COORDINATE_LATITUDE,
        GEO_COORDINATE_LONGITUDE,
        LAND_MARK,
        LOCATION_TYPE,
        POST_OFFICE,
        WHATSAPP_NO,
        
        -- Contact (from address table)
        ALTERNATE_EMAIL_ID,
        EMAIL_ID,
        FAX,
        LANDLINE_NO,
        MOBILE_NO,
        PHONE_NO,
        STD_CODE,
        WORK_NO,
        
        -- Metadata
        load_dt_tm AS ld_dt_tm,
        record_source AS rcrd_src_nm,
        
        -- Hash diff
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(ADDRESS1 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ADDRESS2 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ADDRESS3 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ADDRESS_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(CITY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(COUNTRY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(DISTRICT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(PINCODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(STATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(MOBILE_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(EMAIL_ID AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
        
    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_address
)


, existing AS (
    SELECT hk_prtnr_mstr_cd, rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_addrs_dtls
    QUALIFY ROW_NUMBER() OVER (PARTITION BY hk_prtnr_mstr_cd ORDER BY ld_dt_tm DESC) = 1
)

SELECT s.*
FROM source s
LEFT JOIN existing e ON s.hk_prtnr_mstr_cd = e.hk_prtnr_mstr_cd
WHERE e.hk_prtnr_mstr_cd IS NULL
   OR s.rcrd_hsh_id != e.rcrd_hsh_id


  );
