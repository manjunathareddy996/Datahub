create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_hsptl_infra_dtls
         as
        (

-- Satellite Partner Hospital Infrastructure Details
-- Hub: hub_prtnr_role (hospital infra attributes per role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Hospital beds, ICU, wards, surgery, NABH, provider details

WITH multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

        -- Hospital classification
        sp.HOSPITAL_NAME,
        NULL AS HOSPITAL_TYPE,
        sp.HOSPITAL_SPECIALITY AS HOSPITAL_CATEGORY,
        ONLINE_HOSPITAL_REFERENCE_NUMBER
 AS HOSPITAL_REGISTRATION_NUMBER,

        -- Bed / ICU / Ward capacity
        sp.TOTAL_BEDS AS BED_COUNT,
        sp.BED_OCCUPANCY_RATE_IN_HOSPITAL AS BED_STRENGTH,
        sp.ICU_BEDS,
        NULL AS ICU_AVAILABLE,
        sp.GENERAL_WARD_AC,
        sp.GENERAL_WARD_NON_AC,

        -- Surgery / Specialization
        sp.SURGERY_DETAILS,
        NULL AS SURGERY_FACILITY,
        NULL AS SURGERY_TYPE,
        NULL AS SPECIALIZATION,

        -- Accreditation
        sp.NABH_ACCREDITATION_LEVEL,
        NULL AS NABH_ACCREDITED,
        NULL AS NABH_ACCREDITATION_DATE,
        NULL AS NABH_VALIDITY,

        -- Provider network
        NULL AS PROVIDER_TYPE,
        sp.PROVIDER_CATEGORY,
        NULL AS PROVIDER_NETWORK,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.HOSPITAL_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.HOSPITAL_SPECIALITY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.TOTAL_BEDS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.ICU_BEDS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.NABH_ACCREDITATION_LEVEL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PROVIDER_CATEGORY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SURGERY_DETAILS AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)



SELECT * FROM source


        );
