create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_bnk_fnncl_dtls
         as
        (

-- Satellite Partner Bank Financial Details
-- Hub: hub_prtnr_role (financial details vary by partner role)
-- Source: MULTI_SET_PROPERTY_PIVOT + SIMPLE_PROPERTY_PIVOT
-- Domain: Bank accounts, payment methods, TDS, credit/mandate details

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

multi_set_property AS (
    SELECT
        PARTY_CODE,
        TYPE_OF_PARTY,
        PARTY_STATUS,
        STAKE_CODE,
        hk_prtnr_role_cd,
        
        -- Bank account details
        ACCOUNT_HOLDER_NAME,
        ACCOUNT_NUMBER,
        ACCOUNT_TYPE,
        BANK_ACCOUNT_NUMBER,
        BANK_BRANCH_NAME,
        BANK_NAME,
        IFSC,
        MICR,
        
        -- Payment details
        MANDATE_AMOUNT,
        MANDATE_REGISTERED_ON,
        
        -- Credit / TDS
        TDS_RATE,
        TDS_SECTION_CODE,
        
        -- Metadata
        load_dt_tm,
        record_source
        
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property
),

simple_property AS (
    SELECT
        PARTY_CODE,
        PAYMENT_MODE,
        PAYMENT_METHOD,
        EMANDATE_DETAILS,
        CREDIT_LIMIT,
        CREDIT_DAYS,
        load_dt_tm,
        record_source
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        h.prty_id AS PARTY_CODE,
        h.stake_cd AS STAKE_CODE,

        -- Semantic reference columns
        msp.TYPE_OF_PARTY AS partner_type,
        msp.PARTY_STATUS AS status,

        -- Bank account details
        msp.ACCOUNT_HOLDER_NAME,
        msp.ACCOUNT_NUMBER,
        msp.ACCOUNT_TYPE,
        msp.BANK_ACCOUNT_NUMBER,
        msp.BANK_BRANCH_NAME AS BANK_BRANCH,
        NULL AS BANK_CITY,
        msp.BANK_NAME,
        msp.IFSC AS IFSC_CODE,
        msp.MICR AS MICR_CODE,

        -- Payment details
        sp.PAYMENT_MODE,
        sp.PAYMENT_METHOD AS PAYMENT_TYPE,
        sp.EMANDATE_DETAILS,
        msp.MANDATE_AMOUNT,
        msp.MANDATE_REGISTERED_ON AS MANDATE_DATE,
        NULL AS MANDATE_NUMBER,
        NULL AS MANDATE_STATUS,
        NULL AS MANDATE_TYPE,

        -- Credit / TDS
        sp.CREDIT_LIMIT,
        sp.CREDIT_DAYS AS CREDIT_PERIOD,
        NULL AS TDS_APPLICABLE,
        msp.TDS_RATE AS TDS_PERCENTAGE,
        msp.TDS_SECTION_CODE AS TDS_SECTION,

        -- Metadata
        msp.load_dt_tm AS ld_dt_tm,
        msp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(msp.ACCOUNT_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.BANK_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.IFSC AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.MICR AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PAYMENT_MODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.CREDIT_LIMIT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.TDS_RATE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_role h
    INNER JOIN multi_set_property msp 
        ON h.prty_id = msp.PARTY_CODE 
        AND h.stake_cd = msp.STAKE_CODE
    LEFT JOIN simple_property sp 
        ON h.prty_id = sp.PARTY_CODE
)



SELECT * FROM source


        );
