create or replace transient table BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_hsptl_infra_dtls
         as
        (

-- Satellite Partner Hospital Infrastructure Details
-- Hub: hub_prtnr_role (hospital infra attributes per role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Hospital beds, ICU, wards, surgery, NABH, provider details

WITH multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

        -- Hospital classification
        sp.HOSPITAL_NAME,
        sp.HOSPITAL_TYPE,
        sp.HOSPITAL_CATEGORY,
        sp.HOSPITAL_REGISTRATION_NUMBER,

        -- Bed / ICU / Ward capacity
        sp.BED_COUNT,
        sp.BED_STRENGTH,
        sp.ICU_BEDS,
        sp.ICU_AVAILABLE,
        sp.WARD_TYPE,
        sp.WARD_CATEGORY,

        -- Surgery / Specialization
        sp.SURGERY_FACILITY,
        sp.SURGERY_TYPE,
        sp.SPECIALIZATION,

        -- Accreditation
        sp.NABH_ACCREDITED,
        sp.NABH_ACCREDITATION_DATE,
        sp.NABH_VALIDITY,

        -- Provider network
        sp.PROVIDER_TYPE,
        sp.PROVIDER_CATEGORY,
        sp.PROVIDER_NETWORK,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.HOSPITAL_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.HOSPITAL_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BED_COUNT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.ICU_BEDS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.NABH_ACCREDITED AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PROVIDER_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PROVIDER_NETWORK AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SURGERY_FACILITY AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)



