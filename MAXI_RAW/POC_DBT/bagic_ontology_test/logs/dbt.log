        CURRENT_PERMANENT_OVERSEAS_ADDRESS_TYPE AS crnt_prmnt_ovrseas_addrs_type,
        FLAG_INDICATING_IF_CURRENT_PERMANENT_OVERSEAS_ADDRESS_IS_SAME_AS_CORRESPONDENCE_LOCAL_ADDRESS AS flg_ovrseas_same_as_corr,
        LATITUDE AS latitude,
