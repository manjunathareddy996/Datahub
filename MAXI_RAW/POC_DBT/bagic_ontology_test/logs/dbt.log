create or replace  temporary view BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_lgl_advct_dtls__dbt_tmp
  
   as (
    

-- Satellite Partner Legal Advocate Details
-- Hub: hub_prtnr_role (legal/advocate attributes per role)
-- Source: SIMPLE_PROPERTY_PIVOT + MULTI_SET_PROPERTY
-- Domain: Lawyer type, bar association, court, enrolment, brief counts

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

multi_set AS (
    SELECT
        PARTY_CODE,
        STAKE_CODE,
        hk_prtnr_role_cd,
        TYPE_OF_PARTY,
        PARTY_STATUS
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        h.prty_id AS PARTY_CODE,
        h.stake_cd AS STAKE_CODE,

        -- Semantic reference columns
        ms.TYPE_OF_PARTY AS partner_type,
        ms.PARTY_STATUS AS status,

        -- Lawyer classification
        sp.TYPE_OF_LAWYER AS LAWYER_TYPE,
        NULL AS LAWYER_CATEGORY,
        NULL AS LAWYER_SPECIALIZATION,

        -- Bar association
        sp.BAR_ASSOCIATION_NAMELAWYER AS BAR_ASSOCIATION_NAME,
        NULL AS BAR_ASSOCIATION_NUMBER,
        NULL AS BAR_ASSOCIATION_STATE,
        NULL AS BAR_COUNCIL_REGISTRATION,

        -- Court details
        sp.COURT_NAME,
        NULL AS COURT_TYPE,
        NULL AS COURT_JURISDICTION,

        -- Enrolment
        sp.ENROLMENT_NOLAWYER AS ENROLMENT_NUMBER,
        sp.DATE_OF_JOININGLAWYER AS ENROLMENT_DATE,
        NULL AS ENROLMENT_STATE,

        -- Case volume metrics
        sp.NO_OF_BRIEFS,
        NULL AS NO_OF_COMPANIES,
        NULL AS NO_OF_MACT,
        NULL AS NO_OF_WC,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.TYPE_OF_LAWYER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BAR_ASSOCIATION_NAMELAWYER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.COURT_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.ENROLMENT_NOLAWYER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.NO_OF_BRIEFS AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_role h
    INNER JOIN multi_set ms 
        ON h.prty_id = ms.PARTY_CODE 
        AND h.stake_cd = ms.STAKE_CODE
    LEFT JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON h.prty_id = sp.PARTY_CODE
)



SELECT s.*
FROM source s
LEFT JOIN (
    SELECT hk_prtnr_role_cd, rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_lgl_advct_dtls
    QUALIFY ROW_NUMBER() OVER (PARTITION BY hk_prtnr_role_cd ORDER BY ld_dt_tm DESC) = 1
) e ON s.hk_prtnr_role_cd = e.hk_prtnr_role_cd
WHERE e.hk_prtnr_role_cd IS NULL
   OR s.rcrd_hsh_id != e.rcrd_hsh_id


  );
