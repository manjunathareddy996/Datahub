-- Satellite Partner Hospital Infrastructure Details
-- Hub: hub_prtnr_role (hospital infra attributes per role)
-- Source: stg_partner_multiset_property
-- Domain: Hospital beds, ICU, wards, surgery, NABH, provider details

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        msp.PARTY_CODE,
        msp.STAKE_CODE,

        -- Semantic reference columns
        msp.TYPE_OF_PARTY AS partner_type,
        msp.PARTY_STATUS AS status,

        -- Hospital classification
        msp.HOSPITAL_NAME,
        msp.HOSPITAL_TYPE,
        msp.HOSPITAL_CATEGORY,
        msp.HOSPITAL_REGISTRATION_NUMBER,

        -- Bed / ICU / Ward capacity
        msp.BED_COUNT,
        msp.BED_STRENGTH,
        msp.ICU_BEDS,
        msp.ICU_AVAILABLE,
        msp.WARD_TYPE,
        msp.WARD_CATEGORY,

        -- Surgery / Specialization
        msp.SURGERY_FACILITY,
        msp.SURGERY_TYPE,
        msp.SPECIALIZATION,

        -- Accreditation
        msp.NABH_ACCREDITED,
        msp.NABH_ACCREDITATION_DATE,
        msp.NABH_VALIDITY,

        -- Provider network
        msp.PROVIDER_TYPE,
        msp.PROVIDER_CATEGORY,
        msp.PROVIDER_NETWORK,

        -- Metadata
        msp.load_dt_tm AS ld_dt_tm,
        msp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(msp.HOSPITAL_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.HOSPITAL_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.BED_COUNT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.ICU_BEDS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.NABH_ACCREDITED AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.PROVIDER_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.PROVIDER_NETWORK AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.SURGERY_FACILITY AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property msp
    INNER JOIN hub_role h
        ON msp.PARTY_CODE = h.prty_id
        AND msp.STAKE_CODE = h.stake_cd
)



