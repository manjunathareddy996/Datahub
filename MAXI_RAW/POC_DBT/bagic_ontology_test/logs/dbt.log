-- Travel Claim Payment Details
-- Hub: hub_clm | Attributes: 45
-- Source: NONHLTH_TRV_CLM_VW_DATA_CLAIM_DETAILS_CLAIM_PAYMENT_PAYMENTPROPERTY
-- SCD Type 2: Insert new row on change (append strategy)

WITH hub_clm AS (
    SELECT 
        hk_clm_cd,
        clm_nbr
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_clm
),

source AS (
    SELECT
        src.*,
        FOREIGN_KEY,
        INC_JOB_CREATED_AT,
        REC_REFRESH_AT
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_trvl_clm_nonhlth_trv_clm_vw_data_cd_clm_pmt_paymentproperty src
),

staged AS (
    SELECT
        -- Hub hash key from hub
        h.hk_clm_cd,

        -- Load metadata
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm,

        -- Hash diff for SCD2 change detection
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(src.FOREIGN_KEY AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id,

        -- All business columns from source
        src.*

    FROM source src
    INNER JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_trvl_clm_nonhlth_trv_clm_vw_data_clm_details cd 
        ON src.FOREIGN_KEY = cd.FOREIGN_KEY
    INNER JOIN hub_clm h 
        ON cd.CLAIMNO = h.clm_nbr
)



SELECT * FROM staged


        );
