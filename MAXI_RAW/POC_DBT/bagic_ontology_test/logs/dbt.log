 AS hk_prtnr_mstr_cd,
        CONTRACT_ID,
        POLICY_REF,
        MEMBER_NO,

        -- Member identity
        NAME,
        DATE_OF_BIRTH,
        AGE,
        GENDER,
        RELATION,
        OCCUPATION,
        GROSS_INCOME,
        ASSIGNEE,
        NOMINEE_RLTN,

        -- Coverage
