create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_lgl_advct_dtls
         as
        (

-- Satellite Partner Legal Advocate Details
-- Hub: hub_prtnr_role (legal/advocate attributes per role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Lawyer type, bar association, court, enrolment, brief counts

WITH multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

        -- Lawyer classification
        sp.TYPE_OF_LAWYER AS LAWYER_TYPE,
        NULL AS LAWYER_CATEGORY,
        NULL AS LAWYER_SPECIALIZATION,

        -- Bar association
        sp.BAR_ASSOCIATION_NAMELAWYER AS BAR_ASSOCIATION_NAME,
        NULL AS BAR_ASSOCIATION_NUMBER,
        NULL AS BAR_ASSOCIATION_STATE,
        NULL AS BAR_COUNCIL_REGISTRATION,

        -- Court details
        sp.COURT_NAME,
        NULL AS COURT_TYPE,
        NULL AS COURT_JURISDICTION,

        -- Enrolment
        sp.ENROLMENT_NOLAWYER AS ENROLMENT_NUMBER,
        sp.DATE_OF_JOININGLAWYER AS ENROLMENT_DATE,
        NULL AS ENROLMENT_STATE,

        -- Case volume metrics
        sp.NO_OF_BRIEFS,
        NULL AS NO_OF_COMPANIES,
        NULL AS NO_OF_MACT,
        NULL AS NO_OF_WC,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.TYPE_OF_LAWYER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BAR_ASSOCIATION_NAMELAWYER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.COURT_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.ENROLMENT_NOLAWYER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.NO_OF_BRIEFS AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)



