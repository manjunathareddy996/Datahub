         as
        (

-- Satellite Partner Profile Miscellaneous Details
-- Hub: hub_prtnr_role (catch-all for remaining profile attributes)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Miscellaneous attributes not covered by other satellites

WITH multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

         -- Profile miscellaneous
        sp.REMARKS,
        NULL AS COMMENTS,
        NULL AS NOTES,
        NULL AS DESCRIPTION,
        sp.REFERENCE_CODE AS REFERENCE_NUMBER,
        NULL AS REFERENCE_TYPE,

        -- Classification
        sp.CATEGORY,
        NULL AS SUB_CATEGORY,
        NULL AS CLASS,
        NULL AS GRADE,
        sp.RATING,

        -- Flags / Indicators
        NULL AS ACTIVE_FLAG,
        NULL AS VERIFIED_FLAG,
        NULL AS APPROVED_FLAG,
        NULL AS PRIORITY,

        -- Dates
        sp.EFFECTIVE_DATE,
        sp.EXPIRY_DATE,
        NULL AS LAST_UPDATED_DATE,
        NULL AS REVIEW_DATE,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.REMARKS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.CATEGORY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.RATING AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EFFECTIVE_DATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EXPIRY_DATE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)



