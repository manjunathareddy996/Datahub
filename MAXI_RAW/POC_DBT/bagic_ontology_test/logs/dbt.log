         as
        (

-- Health UWR Medical Rating Details
-- Hub: hub_plcy | Attributes: 27
-- Source: MAXI_HLTH_UWR_VW_DATA
-- SCD Type 2: Insert new row on change (append strategy)

WITH source AS (
    SELECT
        src.*
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_hlth_uwr_basic_detail_attribute src
    limit 100
),

staged AS (
    SELECT
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(FOREIGN_KEY AS VARCHAR), ''))))
    
 AS hk_plcy_cd,
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm,
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(FOREIGN_KEY AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id,
        src.*
    FROM source src
)



SELECT * FROM staged


        );
