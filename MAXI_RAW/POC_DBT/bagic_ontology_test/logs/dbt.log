        o.FROM_DATE,
        
        -- Metadata
        o.load_dt_tm AS ld_dt_tm,
        o.record_source AS rcrd_src_nm,
        
        -- Hash diff (OPUS columns)
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(o.ADDRESS_LINE1 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(o.ADDRESS_LINE2 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(o.ADDRESS_LINE3 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(o.POSTCODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(o.COUNTRY_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(o.TELEPHONE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
        
    FROM hub_mstr h
    INNER JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_address o
        ON h.prty_id = o.PART_ID
),

opus_address_extn AS (
