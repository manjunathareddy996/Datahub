-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Bank accounts, payment methods, TDS, credit/mandate details

WITH multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.PARTNER_TYPE,
        sp.STATUS,

        -- Bank account details
        sp.ACCOUNT_HOLDER_NAME,
        sp.ACCOUNT_NUMBER,
        sp.ACCOUNT_TYPE,
        sp.BANK_ACCOUNT_NUMBER,
        sp.BANK_BRANCH_NAME,
        sp.BANK_NAME,
        sp.IFSC,
        sp.MICR,

        -- Payment details
        sp.PAYMENT_MODE,
        sp.PAYMENT_PLAN_TYPE,
        sp.MANDATE_AMOUNT,
        sp.MANDATE_REGISTERED_ON,
        sp.MANDATE_TYPE,
        sp.NEFT_STATUS,

        -- Credit / TDS
        sp.CREDIT_LIMIT,
        sp.TDS_RATE,
        sp.TDS_SECTION_CODE,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.ACCOUNT_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BANK_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.IFSC AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MICR AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PAYMENT_MODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.NEFT_STATUS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.CREDIT_LIMIT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.TDS_RATE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)



