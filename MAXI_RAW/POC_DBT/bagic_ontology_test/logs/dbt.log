create or replace   view BAGIC_PREPROD_CURATED_DB.UTILS.raw_sat_test
  
   as (
    WITH v_partyProperty_partyProperty_multiSetProperty_multiSetDetail_property AS (
    SELECT *
        FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.PARTY_TEST_VW_DATA_party_detail_party_property_multi_set_property_multi_set_detail_property
