create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_srvyr_invstgtr_dtls
         as
        (

-- Satellite Partner Surveyor Investigator Details
-- Hub: hub_prtnr_role (surveyor/investigator attributes per role)
-- Source: stg_partner_simple_property + stg_partner_multiset_property
-- Domain: Surveyor license, evaluation, staff strength, equipment

WITH hub_role AS (
    SELECT hk_prtnr_role_cd, prty_id, stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        msp.PARTY_CODE,
        msp.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

        -- Surveyor details
        NULL AS SURVEYOR_CODE,
        sp.TYPE_OF_SURVEYOR AS SURVEYOR_TYPE,
        NULL AS SURVEYOR_CATEGORY,
        sp.SUR_LICENSE_NO AS SURVEYOR_LICENSE_NUMBER,
        NULL AS SURVEYOR_LICENSE_VALID_FROM,
        NULL AS SURVEYOR_LICENSE_VALID_TO,

        -- Evaluation
        NULL AS EVALUATION_TYPE,
        NULL AS EVALUATION_CAPACITY,
        NULL AS EVALUATION_LIMIT,

        -- FOSFEET (Federation of Surveyors)
        sp.FOSFEET_ON_STREET AS FOSFEET_MEMBERSHIP,
        NULL AS FOSFEET_NUMBER,

        -- Staff / Equipment
        NULL AS STAFF_STRENGTH_TECHNICAL,
        NULL AS STAFF_STRENGTH_CLERICAL,
        sp.STAFF_STRENGTH_TOTAL,
        sp.NO_OF_COMPUTERSTOTAL AS NO_OF_COMPUTERS,
        sp.NO_OF_PRINTERSTOTAL AS NO_OF_PRINTERS,

        -- Metadata
        msp.load_dt_tm AS ld_dt_tm,
        msp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.TYPE_OF_SURVEYOR AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SUR_LICENSE_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.STAFF_STRENGTH_TOTAL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.NO_OF_COMPUTERSTOTAL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.NO_OF_PRINTERSTOTAL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.FOSFEET_ON_STREET AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property msp
    INNER JOIN hub_role h
        ON msp.PARTY_CODE = h.prty_id
        AND msp.STAKE_CODE = h.stake_cd
    INNER JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp
        ON msp.PARTY_CODE = sp.PARTY_CODE
)



SELECT * FROM source


        );
