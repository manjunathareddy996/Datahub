create or replace transient table BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_ins_lob_prfl_dtls
         as
        (

-- Satellite Partner Insurance LOB Profile Details
-- Hub: hub_prtnr_role (insurance line-of-business profile per role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Fire, motor, health, travel, marine, engineering, aviation, crop, product flags

WITH multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

        -- LOB flags / profiles
        sp.FIRE,
        sp.MOTOR,
        sp.HEALTH,
        sp.TRAVEL,
        sp.MARINE_CARGO,
        sp.MARINE_HULL,
        sp.ENGINEERING,
        sp.AVIATION,
        sp.CROP_INSURANCE,
        sp.CROP_TYPE,

        -- Product details
        sp.PRODUCT_CODE,
        sp.PRODUCT_NAME,
        sp.PRODUCT_TYPE,
        sp.PRODUCT_CATEGORY,

        -- LOB-specific limits
        sp.FIRE_LIMIT,
        sp.MOTOR_LIMIT,
        sp.HEALTH_LIMIT,
        sp.MARINE_LIMIT,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.FIRE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MOTOR AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.HEALTH AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.TRAVEL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MARINE_CARGO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.ENGINEERING AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.AVIATION AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PRODUCT_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PRODUCT_TYPE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)



SELECT * FROM source


        );
