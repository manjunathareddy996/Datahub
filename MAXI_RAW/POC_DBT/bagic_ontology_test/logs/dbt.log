        src.FROM_DATE,

        -- Versioning
        src.VERSION,
        src.EVENT_DATE,
        src.USERID,
        src.EXT_USER,

        -- CDC
        src.GG_CHANGE_DATE,

        -- Load metadata
        CURRENT_TIMESTAMP() AS load_dt_tm,
        'OPUS' AS record_source

    FROM source src
    INNER JOIN partner p ON src.ADD_ID = p.ADD_ID
)

SELECT * FROM staged
  );
