create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_trvl_uwr_risk_itnry_dtls
         as
        (

-- Travel UWR Risk Itinerary Details
-- Hub: hub_plcy | Attributes: 60
-- Source: NONHLTH_TRV_UWR_VW_DATA_POLICY_DETAILS_POLICY_PROPERTY_SIMPLE_PROPERTY_PIVOT_VW_2_1
-- SCD Type 2: Insert new row on change (append strategy)

WITH hub_plcy AS (
    SELECT 
        hk_plcy_cd,
        plcy_nbr
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_plcy
),

source AS (
    SELECT src.*
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_trvl_plcy_pd_polp_sp_pvt src
),

staged AS (
    SELECT
        -- Hub hash key from hub
        h.hk_plcy_cd,

        -- Load metadata
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm,

        -- Hash diff for SCD2 change detection
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(src.FOREIGN_KEY AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id,

        -- All business columns from source
        src.*

    FROM source src
    INNER JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_trvl_plcy_policy_details pd 
        ON src.FOREIGN_KEY = pd.FOREIGN_KEY
    INNER JOIN hub_plcy h 
        ON pd.POLICY_NUMBER = h.plcy_nbr
)



SELECT * FROM staged


        );
