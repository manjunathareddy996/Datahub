create or replace transient table BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_cmmn_dtls
         as
        (

-- Satellite Partner Common Details
-- Hub: hub_prtnr_mstr (person-level, role-independent)
-- Contains: Name, DOB, gender, nationality, marital status, occupation

WITH source AS (
    SELECT
        hk_prtnr_mstr_cd,
        PARTY_CODE,
        
        -- From party detail table
        FIRST_NAME,
        LAST_NAME,
        MIDDLE_NAME,
        TITLE,
        GENDER,
        DATE_OF_BIRTH,
        NATIONALITY,
        OCCUPATION,
        PARTY_STATUS,
        TYPE_OF_PARTY,
        BUSINESS_NAME,
        PARENT_PARTY_CODE,
        TYPE_OF_ORGANIZATION,
        
        -- Metadata
        load_dt_tm,
        record_source,
        INC_JOB_CREATED_AT
    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_detail
),

-- Additional attributes from simple property pivot
simple_prop AS (
    SELECT
        hk_prtnr_mstr_cd,
        -- Common detail attributes from simple property
        ACTIVE_DATE,
        AGE,
        COMMUNICATION_AND_PREFERRED_LANGUAGE,
        COUNTRY_OF_BIRTH,
        COUNTRY_OF_CITIZENSHIP,
        COUNTRY_OF_RESIDENCE,
        DATE_OF_DEATH,
        DATE_OF_MARRIAGE,
        DISABILITY_PERCENTAGE,
        EDUCATION,
        FATHER_NAME,
        FATHERSPOUSE_NAME,
        HEIGHT,
        INACTIVE_DATA,
        LANGUAGES_PREFERRED,
        LOCATION_OF_DISABILITY,
        MARITAL_STATUS,
        MIDDLE_NAME AS SP_MIDDLE_NAME,
        MOTHER_MAIDEN_NAME,
        MOTHERS_MAIDEN_NAME,
        NOMINEE_DETAIL,
        NOMINEE_DETAILS,
        NOMINEE_RELATIONSHIP,
        NUMBER_OF_DAUGHTERS,
        NUMBER_OF_SON,
        OCCUPATION AS SP_OCCUPATION,
        OTHER_OCCUPATION,
        OTHER_RELATIONSHIP,
        PARENT_PARTY_CODE AS SP_PARENT_PARTY_CODE,
        PARTNER_REF,
        PARTY_FUNCTION,
        PARTY_FUNCTIONS,
        PARTY_LANGUAGE,
        PHYSICALLY_CHALLENGED,
        RELATIONSHIP,
        RELATIONSHIP_WITH_EMPLOYEE,
        RELATIONSHIP_WITH_HNI,
        RELATIONSHIP_WITH_PRIVE,
        SPOUSE_NAME,
        STATUS,
        WEIGHT
    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property
),

combined AS (
    SELECT
        s.hk_prtnr_mstr_cd,
        s.load_dt_tm AS ld_dt_tm,
        s.record_source AS rcrd_src_nm,
        
        -- Hash diff for change detection
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(s.FIRST_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(s.LAST_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(s.MIDDLE_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(s.TITLE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(s.GENDER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(s.DATE_OF_BIRTH AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(s.NATIONALITY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(s.OCCUPATION AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(s.PARTY_STATUS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(s.TYPE_OF_PARTY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MARITAL_STATUS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EDUCATION AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.FATHER_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SPOUSE_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.HEIGHT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.WEIGHT AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id,
        
        -- Partner type & status (semantic refs)
        s.TYPE_OF_PARTY AS partner_type,
        s.PARTY_STATUS AS status,
        
        -- Business attributes
        s.FIRST_NAME AS first_name,
        s.LAST_NAME AS last_name,
        s.MIDDLE_NAME AS middle_name,
        s.TITLE AS title,
        s.GENDER AS gender,
        s.DATE_OF_BIRTH AS date_of_birth,
        s.NATIONALITY AS nationality,
        s.OCCUPATION AS occupation,
        s.BUSINESS_NAME AS business_name,
        s.PARENT_PARTY_CODE AS parent_party_code,
        s.TYPE_OF_ORGANIZATION AS type_of_organization,
        sp.ACTIVE_DATE AS active_date,
        sp.AGE AS age,
        sp.COMMUNICATION_AND_PREFERRED_LANGUAGE AS communication_language,
        sp.COUNTRY_OF_BIRTH AS country_of_birth,
        sp.COUNTRY_OF_CITIZENSHIP AS country_of_citizenship,
        sp.COUNTRY_OF_RESIDENCE AS country_of_residence,
        sp.DATE_OF_DEATH AS date_of_death,
        sp.DATE_OF_MARRIAGE AS date_of_marriage,
        sp.DISABILITY_PERCENTAGE AS disability_percentage,
        sp.EDUCATION AS education,
        sp.FATHER_NAME AS father_name,
        sp.FATHERSPOUSE_NAME AS fatherspouse_name,
        sp.HEIGHT AS height,
        sp.LANGUAGES_PREFERRED AS languages_preferred,
        sp.MARITAL_STATUS AS marital_status,
        sp.MOTHER_MAIDEN_NAME AS mother_maiden_name,
        sp.NOMINEE_DETAIL AS nominee_detail,
        sp.NOMINEE_DETAILS AS nominee_details,
        sp.NOMINEE_RELATIONSHIP AS nominee_relationship,
        sp.NUMBER_OF_DAUGHTERS AS number_of_daughters,
        sp.NUMBER_OF_SON AS number_of_son,
        sp.OTHER_OCCUPATION AS other_occupation,
        sp.OTHER_RELATIONSHIP AS other_relationship,
        sp.PARTNER_REF AS partner_ref,
        sp.PARTY_FUNCTION AS party_function,
        sp.PARTY_LANGUAGE AS party_language,
        sp.PHYSICALLY_CHALLENGED AS physically_challenged,
        sp.RELATIONSHIP AS relationship,
        sp.RELATIONSHIP_WITH_EMPLOYEE AS relationship_with_employee,
        sp.SPOUSE_NAME AS spouse_name,
        sp.WEIGHT AS weight
        
    FROM source s
    LEFT JOIN simple_prop sp ON s.hk_prtnr_mstr_cd = sp.hk_prtnr_mstr_cd
)



SELECT * FROM combined


        );
