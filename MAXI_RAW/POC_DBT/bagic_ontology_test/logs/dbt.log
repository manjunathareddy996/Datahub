[0m13:58:20.143399 [debug] [Thread-2 (]: On model.bagic_ontology.stg_opus_partner: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "demo_dbt", "target_name": "dev", "node_id": "model.bagic_ontology.stg_opus_partner"} */
create or replace   view BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_partner
  
   as (
    

-- Staging: OPUS core partner identity
-- Source: CP_PARTNERS (equivalent to MAXIMUS PARTY_DETAIL)
-- BK: PART_ID

WITH source AS (
    SELECT *
    FROM BAGIC_PROD_MIRROR_DB.OPUS_GG_DWHSTAGE.CP_PARTNERS
    WHERE PART_ID IS NOT NULL
),

staged AS (
    SELECT
        -- Business Key
        CAST(PART_ID AS VARCHAR) AS PART_ID,

        -- Hash key (same grain as MAXIMUS hub_prtnr_mstr)
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(PART_ID AS VARCHAR), ''))))
    
 AS hk_prtnr_mstr_cd,

        -- Core identity attributes
        SURNAME,
        FIRST_NAME,
        MIDDLE_NAME,
        NAME,
        SHORT_NAME,
        INSTITUTION_NAME,
        BEFORE_TITLE,
        AFTER_TITLE,
        PARTNER_TYPE,
        PARTNER_REF,
        TRY_TO_DATE(DATE_OF_BIRTH, 'DD/MM/YYYY') AS DATE_OF_BIRTH,
        TRY_TO_DATE(DATE_OF_DEATH, 'DD/MM/YYYY') AS DATE_OF_DEATH,
        CAUSE_OF_DEATH,
        PROOF_OF_DEATH,
        SEX,
        NATIONALITY,
        MARITAL_STATUS,
        OCCUPATION,
        EMPLOYMENT_STATUS,
        LANGUAGE,
        LEGAL_FORM,
        DATA_STATUS,

        -- Contact
        TELEPHONE,
        TELEPHONE2,
        EMAIL,
        FAX,
        CONTACT1,
        CONTACT2,

        -- Identification
        TAX_ID,
        VAT_NUMBER,
        NATIONAL_ID,
        DNI,
        REG_NUMBER,
        EVID_TYPE,
        EVIDENCE,

        -- Address reference
        ADD_ID,
        ADDRESSEE,
        FROM_DATE,

        -- LUA / custom
        LUA_VALUE_1,
        LUA_VALUE_2,
        LUA_VALUE_3,
        QUALITY,
        LITERATURE,
        NOTES,

        -- Versioning
        VERSION,
        EVENT_DATE,
        USERID,
        EXT_USER,
        LAST_CHANGE_DATE,

        -- CDC
        GG_CHANGE_DATE,

        -- Load metadata
        CURRENT_TIMESTAMP() AS load_dt_tm,
        'OPUS' AS record_source

    FROM source
)

SELECT * FROM staged
  );
