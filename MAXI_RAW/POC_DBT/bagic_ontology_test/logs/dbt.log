         as
        (

-- Satellite Partner Hospital MOU Status Details
-- Hub: hub_prtnr_role (MOU/agreement status per hospital role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: MOU, blacklist, suspension, discount, tariff, advance details

WITH multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

        -- MOU details
        sp.MOU_STATUS,
        sp.MOU_VALIDITY_START_DATE AS MOU_START_DATE,
        sp.MOU_VALIDITY_END_DATE AS MOU_END_DATE,
        NULL AS MOU_RENEWAL_DATE,
        sp.TYPE_OF_MOU AS MOU_TYPE,
        NULL AS MOU_SIGNED_DATE,

        -- Blacklist / Suspension
        sp.BLACKLISTED AS BLACKLIST_STATUS,
        sp.REASON_BLACKLISTED AS BLACKLIST_REASON,
        sp.DATE_OF_BLACKLISTING AS BLACKLIST_DATE,
        sp.SUSPENDED AS SUSPENDED_STATUS,
        sp.SUSPENDED_REASON,
        sp.SUSPENDED_EFFECTIVE_DATE AS SUSPENDED_DATE,

        -- Discount / Tariff
        sp.DISCOUNT_PERCENTAGE,
        sp.DISCOUNT_TYPE,
        sp.SPECIAL_TARIFF AS TARIFF_TYPE,
        NULL AS TARIFF_CATEGORY,

        -- Advance
        sp.ADVANCE_AMOUNT,
        sp.ADVANCE_PAYMENT_APPLICABLE AS ADVANCE_STATUS,
        sp.ADVANCE_PAYMENT_START_DATE AS ADVANCE_DATE,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.MOU_STATUS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MOU_VALIDITY_START_DATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MOU_VALIDITY_END_DATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BLACKLISTED AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SUSPENDED AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.DISCOUNT_PERCENTAGE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SPECIAL_TARIFF AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.ADVANCE_PAYMENT_APPLICABLE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)



