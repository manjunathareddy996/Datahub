    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        msp.PARTY_CODE,
        msp.STAKE_CODE,

        -- Semantic reference columns
        msp.TYPE_OF_PARTY AS partner_type,
        msp.PARTY_STATUS AS status,

        -- Surveyor details
        NULL AS SURVEYOR_CODE,
        msp.TYPE_OF_SURVEYOR AS SURVEYOR_TYPE,
        NULL AS SURVEYOR_CATEGORY,
        msp.SUR_LICENSE_NO AS SURVEYOR_LICENSE_NUMBER,
        NULL AS SURVEYOR_LICENSE_VALID_FROM,
        NULL AS SURVEYOR_LICENSE_VALID_TO,

        -- Evaluation
        NULL AS EVALUATION_TYPE,
        NULL AS EVALUATION_CAPACITY,
        NULL AS EVALUATION_LIMIT,

        -- FOSFEET (Federation of Surveyors)
        msp.FOSFEET_ON_STREET AS FOSFEET_MEMBERSHIP,
        NULL AS FOSFEET_NUMBER,

        -- Staff / Equipment
        NULL AS STAFF_STRENGTH_TECHNICAL,
        NULL AS STAFF_STRENGTH_CLERICAL,
        msp.STAFF_STRENGTH_TOTAL,
        msp.NO_OF_COMPUTERSTOTAL AS NO_OF_COMPUTERS,
        msp.NO_OF_PRINTERSTOTAL AS NO_OF_PRINTERS,

        -- Metadata
        msp.load_dt_tm AS ld_dt_tm,
        msp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(msp.TYPE_OF_SURVEYOR AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.SUR_LICENSE_NO AS VARCHAR), '')))
