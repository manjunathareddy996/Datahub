create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
         as
        (

-- Hub Partner Role: One row per partner+role combination
-- Business Key: PARTY_CODE + STAKE_CODE (composite)
-- Grain: One partner playing one role = one row
-- Sources: MAXIMUS (multi-set pivot) + OPUS (BJAZ_CLM_SUPP_EXTN type, BJAZ_INTERMEDIARY)

WITH maximus_source AS (
    SELECT
        pd.PARTY_CODE AS prty_id,
        ms.STAKE_CODE AS stake_cd,
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(pd.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

-- OPUS: Intermediaries are AGENT role
opus_intermediary AS (
    SELECT
        PART_ID AS prty_id,
        'AGENT' AS stake_cd,
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(PART_ID AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST('AGENT' AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        load_dt_tm AS ld_dt_tm,
        record_source AS rcrd_src_nm
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_intermediary
),

-- OPUS: Suppliers have role based on SUPP_TYPE (SURVEYOR, DEALER, LAWYER, etc.)
opus_supplier AS (
    SELECT
        PART_ID AS prty_id,
        SUPP_TYPE AS stake_cd,
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(PART_ID AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(SUPP_TYPE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        load_dt_tm AS ld_dt_tm,
        record_source AS rcrd_src_nm
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_clm_supplier
    WHERE SUPP_TYPE IS NOT NULL
      AND SUPP_TYPE != ''
),

-- OPUS: Hospital master = HOSPITAL role
opus_hospital AS (
    SELECT
        PART_ID AS prty_id,
        'HOSPITAL' AS stake_cd,
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(PART_ID AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST('HOSPITAL' AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        load_dt_tm AS ld_dt_tm,
        record_source AS rcrd_src_nm
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_hospital_master
),

source AS (
    SELECT * FROM maximus_source
    UNION ALL
    SELECT * FROM opus_intermediary
    UNION ALL
    SELECT * FROM opus_supplier
    UNION ALL
    SELECT * FROM opus_hospital
),



new_records AS (
    SELECT DISTINCT
        hk_prtnr_role_cd,
        prty_id,
        stake_cd,
        ld_dt_tm,
        rcrd_src_nm
    FROM source
    
)

SELECT * FROM new_records
        );
