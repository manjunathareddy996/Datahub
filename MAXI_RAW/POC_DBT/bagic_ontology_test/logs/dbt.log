create or replace  temporary view BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_bsnss_cmplnc_dtls__dbt_tmp
  
   as (
    

-- Satellite Partner Business Compliance Details
-- Hub: hub_prtnr_role (business compliance per role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: GST, registration, statewise GSTIN, business details

WITH multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.PARTY_STATUS AS status,

        -- GST details
        NULL AS GST_APPLICABLE,
        NULL AS GST_NUMBER,
        sp.GSTIN_ISSUANCE_DT AS GST_REGISTRATION_DATE,
        NULL AS GST_STATE,
        NULL AS GST_TYPE,
        sp.GSTINUIN AS GSTIN,
        sp.GSTN_NUMBER AS GSTIN_NUMBER,

        -- Statewise GSTIN
        sp.STATEWISE_GSTIN_DETAILS AS STATEWISE_GSTIN_1,
        NULL AS STATEWISE_GSTIN_2,
        NULL AS STATEWISE_GSTIN_3,
        NULL AS STATEWISE_GSTIN_STATE_1,
        NULL AS STATEWISE_GSTIN_STATE_2,

        -- Registration
        sp.REGISTRATION_NO AS REGISTRATION_NUMBER,
        sp.SEZ_REGISTRATION_DATE AS REGISTRATION_DATE,
        NULL AS REGISTRATION_VALID_TILL,
        NULL AS REGISTRATION_TYPE,

        -- Business details
        sp.BUSINESS_TYPE,
        NULL AS BUSINESS_CATEGORY,
        NULL AS BUSINESS_NATURE,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.GSTINUIN AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.GSTN_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.REGISTRATION_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SEZ_REGISTRATION_DATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BUSINESS_TYPE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)


, existing AS (
    SELECT hk_prtnr_role_cd, rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_bsnss_cmplnc_dtls
    QUALIFY ROW_NUMBER() OVER (PARTITION BY hk_prtnr_role_cd ORDER BY ld_dt_tm DESC) = 1
)

SELECT s.*
FROM source s
LEFT JOIN existing e ON s.hk_prtnr_role_cd = e.hk_prtnr_role_cd
WHERE e.hk_prtnr_role_cd IS NULL
   OR s.rcrd_hsh_id != e.rcrd_hsh_id


  );
