   as (
    

-- Staging: OPUS senior health member details
-- Source: BJAZ_SH_MEM_DTLS_EXTN
-- Senior citizen health product members
-- BK: PARTNER_ID + CONTRACT_ID + MEMBER_NO

WITH source AS (
    SELECT *
