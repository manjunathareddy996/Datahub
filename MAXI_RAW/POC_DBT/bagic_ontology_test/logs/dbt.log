create or replace transient table BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_agnt_dtls
         as
        (

-- Satellite Partner Agent Details
-- Hub: hub_prtnr_role (agent-specific attributes per role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Branch, license, IRDA, channel, intermediary details

WITH party_detail AS (
    SELECT FOREIGN_KEY, PARTY_CODE, TYPE_OF_PARTY, PARTY_STATUS
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL
    WHERE PARTY_CODE IS NOT NULL
),

multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM party_detail pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        pd.TYPE_OF_PARTY AS partner_type,
        pd.PARTY_STATUS AS status,

        -- Branch details
        sp.BRANCH_CODE,
        sp.BRANCH_NAME,
        sp.BRANCH AS BRANCH_OFFICE,
        NULL AS BRANCH_STATE,

        -- License / IRDA
        sp.LICENSE_NUMBER,
        sp.LICENSE_ISSUE_DATE AS LICENSE_VALID_FROM,
        sp.LICENSE_EXPIRY_DATE AS LICENSE_VALID_TO,
        sp.IRDA_CODE AS IRDA_LICENSE_NUMBER,
        NULL AS IRDA_LICENSE_VALID_FROM,
        NULL AS IRDA_LICENSE_VALID_TO,

        -- Channel / Intermediary
        sp.AGENT_CHANNEL AS CHANNEL,
        sp.SUB_CHANNEL,
        NULL AS INTERMEDIARY_CODE,
        NULL AS INTERMEDIARY_NAME,
        sp.INTERMEDIARY_TYPE,

        -- Agent classification
        NULL AS AGENT_CODE,
        NULL AS AGENT_TYPE,
        sp.EMPLOYEE_STATUS AS AGENT_STATUS,
        NULL AS AGENT_CATEGORY,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.BRANCH_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.LICENSE_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.IRDA_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.AGENT_CHANNEL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SUB_CHANNEL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.INTERMEDIARY_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EMPLOYEE_STATUS AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
    INNER JOIN party_detail pd ON sp.PARTY_CODE = pd.PARTY_CODE
)



SELECT * FROM source


        );
