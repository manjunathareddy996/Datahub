        NAME_AS_PER_PAN_NUMBER,
        NREGA_JOB_CARD,
        PAN_AADHAAR_LINKED,
        PAN_APPLICATION_NO,
        PAN_APPLIED_FOR,
        PAN_NO,
        PAN_NUMBER,
        PASSPORT_DETAILS,
        PASSPORT_FILE_NO,
        PASSPORT_NUMBER,
        POA_AADHAR_CARD_STATUS,
        POA_DOCUMENT_STATUS,
        POA_DRIVING_LICENSE_STATUS,
        POA_NREGA_JOB_CARD_STATUS,
