         as
        (

-- Satellite Partner Contact Details
-- Hub: hub_prtnr_role (contact info can vary by role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Mobile, email, phone, WhatsApp, fax, landline

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

multi_set AS (
    SELECT
        pd.PARTY_CODE,
        msp.STAKE_CODE,
        msp.FOREIGN_KEY,
        msp.MOBILE_NO,
        msp.EMAIL_ID
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 msp
        ON pd.FOREIGN_KEY = msp.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND msp.STAKE_CODE IS NOT NULL
      AND msp.STAKE_CODE != ''
),

address_property AS (
    SELECT
        pd.PARTY_CODE,
        ap.WHATSAPP_NO
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_ADDRESS_ADDRESS_PROPERTY_PIVOT_VW_2_1 ap
        ON pd.FOREIGN_KEY = ap.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        h.prty_id AS PARTY_CODE,
        h.stake_cd AS STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

        -- Mobile numbers
        msp.MOBILE_NO,
        NULL AS MOBILE_NUMBER,
        NULL AS MOBILE_NUMBER_1,
        NULL AS MOBILE_NUMBER_2,
        NULL AS ALTERNATE_MOBILE_NO,

        -- Email addresses
        msp.EMAIL_ID,
        NULL AS EMAIL_ADDRESS,
        NULL AS ALTERNATE_EMAIL_ID,
        NULL AS OFFICIAL_EMAIL_ID,

        -- Phone / Landline
        sp.PHONE_NO_1 AS PHONE_NO,
        sp.PHONE_NO_2 AS PHONE_NUMBER,
        sp.LANDLINE_NO,
        sp.ALTERNATE_MOB_NUMBERLANDLINE_NUMBER AS LANDLINE_NUMBER,
        sp.STD_CODE,

        -- WhatsApp / Fax
        ap.WHATSAPP_NO,
        NULL AS WHATSAPP_NUMBER,
        NULL AS FAX,
        NULL AS FAX_NUMBER,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(msp.MOBILE_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.EMAIL_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PHONE_NO_1 AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.LANDLINE_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ap.WHATSAPP_NO AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_role h
    INNER JOIN multi_set msp 
        ON h.prty_id = msp.PARTY_CODE 
        AND h.stake_cd = msp.STAKE_CODE
    LEFT JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON h.prty_id = sp.PARTY_CODE
    LEFT JOIN address_property ap 
        ON h.prty_id = ap.PARTY_CODE
)



