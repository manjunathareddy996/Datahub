create or replace transient table BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_cntct_dtls
         as
        (

-- Satellite Partner Contact Details
-- Hub: hub_prtnr_role (contact info can vary by role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Mobile, email, phone, WhatsApp, fax, landline

WITH multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

        -- Mobile numbers
        msp.MOBILE_NO,
        NULL AS MOBILE_NUMBER,
        NULL AS MOBILE_NUMBER_1,
        NULL AS MOBILE_NUMBER_2,
        NULL AS ALTERNATE_MOBILE_NO,

        -- Email addresses
        msp.EMAIL_ID,
        NULL AS EMAIL_ADDRESS,
        NULL AS ALTERNATE_EMAIL_ID,
        NULL AS OFFICIAL_EMAIL_ID,

        -- Phone / Landline
        sp.PHONE_NO_1 AS PHONE_NO,
        sp.PHONE_NO_2 AS PHONE_NUMBER,
        sp.LANDLINE_NO,
        sp.ALTERNATE_MOB_NUMBERLANDLINE_NUMBER AS LANDLINE_NUMBER,
        sp.STD_CODE,

        -- WhatsApp / Fax
        'check add_property' AS WHATSAPP_NO,
        NULL AS WHATSAPP_NUMBER,
        NULL AS FAX,
        NULL AS FAX_NUMBER,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.MOBILE_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MOBILE_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EMAIL_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.EMAIL_ADDRESS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PHONE_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.LANDLINE_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.WHATSAPP_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.FAX AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)



SELECT * FROM source


        );
