create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_bnk_fnncl_dtls
         as
        (

-- Satellite Partner Bank Financial Details
-- Hub: hub_prtnr_role (bank details can vary by role)
-- Sources: MAXIMUS (simple property) + OPUS (AZBJ_PARTNER_EXTN + BJAZ_AZBJ_PART_EXT_HIST)
-- Per OPUS_MAPPING_FINAL: 13 OPUS columns land here (bank/financial from partner extn only)
-- Note: Supplier bank fields (SUPP_BANK_NAME etc) now go to sat_prtnr_srvyr_invstgtr_dtls

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

maximus_source AS (
    SELECT
        h.hk_prtnr_role_cd,
        sp.hk_prtnr_mstr_cd,
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,
        
        -- Columns in hash_diff (MAXIMUS naming)
        sp.BANK_ACCOUNT_NUMBER,
        sp.BANK_ACCOUNT_TYPE,
        sp.IFSC_CODE,
        sp.MICR_CODE,
        
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.BANK_ACCOUNT_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BANK_ACCOUNT_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.IFSC_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MICR_CODE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
        
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp
    INNER JOIN hub_role h 
        ON 
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST('ALL' AS VARCHAR), '')))
                
                
            )
        )
    
 = h.hk_prtnr_role_cd
    WHERE sp.BANK_ACCOUNT_NUMBER IS NOT NULL
       OR sp.IFSC_CODE IS NOT NULL
       OR sp.BANK_NAME IS NOT NULL
),

opus_partner_extn AS (
    SELECT
        h.hk_prtnr_role_cd,
        ope.hk_prtnr_mstr_cd,
        ope.load_dt_tm AS ld_dt_tm,
        ope.record_source AS rcrd_src_nm,
        
        -- Columns in hash_diff (map OPUS to MAXIMUS naming)
        ope.ACCOUNT_NO AS BANK_ACCOUNT_NUMBER,
        ope.ACC_TYPE AS BANK_ACCOUNT_TYPE,
        ope.IFSC_CODE,
        ope.MICR_CODE,
        
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(ope.ACCOUNT_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.ACC_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.IFSC_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ope.MICR_CODE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
        
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_partner_extn ope
    INNER JOIN hub_role h 
        ON h.prty_id = CAST(ope.PART_ID AS VARCHAR)
    WHERE ope.ACCOUNT_NO IS NOT NULL
       OR ope.IFSC_CODE IS NOT NULL
       OR ope.PAIDUP_CAPITAL IS NOT NULL
),

opus_partner_extn_hist AS (
    SELECT
        h.hk_prtnr_role_cd,
        opeh.hk_prtnr_mstr_cd,
        opeh.load_dt_tm AS ld_dt_tm,
        opeh.record_source AS rcrd_src_nm,
        
        -- Columns in hash_diff (map OPUS to MAXIMUS naming)
        opeh.ACCOUNT_NO AS BANK_ACCOUNT_NUMBER,
        opeh.ACC_TYPE AS BANK_ACCOUNT_TYPE,
        opeh.IFSC_CODE,
        opeh.MICR_CODE,
        
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(opeh.ACCOUNT_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(opeh.ACC_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(opeh.IFSC_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(opeh.MICR_CODE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
        
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_partner_extn_hist opeh
    INNER JOIN hub_role h 
        ON h.prty_id = CAST(opeh.PART_ID AS VARCHAR)
    WHERE opeh.ACCOUNT_NO IS NOT NULL
       OR opeh.IFSC_CODE IS NOT NULL
       OR opeh.PAIDUP_CAPITAL IS NOT NULL
),

combined AS (
    SELECT * FROM maximus_source
    UNION ALL
    SELECT * FROM opus_partner_extn
    UNION ALL
    SELECT * FROM opus_partner_extn_hist
)



SELECT * FROM combined


        );
