create or replace transient table BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_bnk_fnncl_dtls
         as
        (

-- Satellite Partner Bank Financial Details
-- Hub: hub_prtnr_role (financial details vary by partner role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Bank accounts, payment methods, TDS, credit/mandate details

WITH source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        PARTY_CODE,

        -- Semantic reference columns
        TYPE_OF_PARTY AS partner_type,
        STATUS AS status,

        -- Bank account details
        ACCOUNT_HOLDER_NAME,
        ACCOUNT_NUMBER,
        ACCOUNT_TYPE,
        BANK_ACCOUNT_NUMBER,
        BANK_BRANCH,
        BANK_CITY,
        BANK_NAME,
        IFSC_CODE,
        MICR_CODE,

        -- Payment details
        PAYMENT_MODE,
        PAYMENT_TYPE,
        MANDATE_AMOUNT,
        MANDATE_DATE,
        MANDATE_NUMBER,
        MANDATE_STATUS,
        MANDATE_TYPE,

        -- Credit / TDS
        CREDIT_LIMIT,
        CREDIT_PERIOD,
        TDS_APPLICABLE,
        TDS_PERCENTAGE,
        TDS_SECTION,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        load_dt_tm AS ld_dt_tm,
        record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(ACCOUNT_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(BANK_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(IFSC_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(MICR_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(PAYMENT_MODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(MANDATE_STATUS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(CREDIT_LIMIT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(TDS_APPLICABLE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property
    WHERE STAKE_CODE IS NOT NULL
)



SELECT * FROM source


        );
