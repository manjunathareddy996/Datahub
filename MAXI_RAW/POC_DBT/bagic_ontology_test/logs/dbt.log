        STATUS AS status,

        -- Branch details
        BRANCH_CODE,
        BRANCH_NAME,
        BRANCH_OFFICE,
        BRANCH_STATE,

        -- License / IRDA
        LICENSE_NUMBER,
        LICENSE_VALID_FROM,
        LICENSE_VALID_TO,
        IRDA_LICENSE_NUMBER,
        IRDA_LICENSE_VALID_FROM,
        IRDA_LICENSE_VALID_TO,

        -- Channel / Intermediary
        CHANNEL,
        SUB_CHANNEL,
        INTERMEDIARY_CODE,
        INTERMEDIARY_NAME,
        INTERMEDIARY_TYPE,

        -- Agent classification
        AGENT_CODE,
        AGENT_TYPE,
        AGENT_STATUS,
        AGENT_CATEGORY,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        load_dt_tm AS ld_dt_tm,
        record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(BRANCH_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(LICENSE_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(IRDA_LICENSE_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(CHANNEL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(SUB_CHANNEL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(INTERMEDIARY_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(AGENT_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(AGENT_STATUS AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property
    WHERE STAKE_CODE IS NOT NULL
)


, existing AS (
    SELECT hk_prtnr_role_cd, rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.UTILS.sat_prtnr_agnt_dtls
    QUALIFY ROW_NUMBER() OVER (PARTITION BY hk_prtnr_role_cd ORDER BY ld_dt_tm DESC) = 1
)

SELECT s.*
FROM source s
LEFT JOIN existing e ON s.hk_prtnr_role_cd = e.hk_prtnr_role_cd
WHERE e.hk_prtnr_role_cd IS NULL
   OR s.rcrd_hsh_id != e.rcrd_hsh_id


  );
