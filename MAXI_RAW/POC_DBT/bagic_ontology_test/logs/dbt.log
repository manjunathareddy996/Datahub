        NULL AS WORK_NO,
        
        -- OPUS columns
        NULL AS ADDRESS_LINE4,
        NULL AS ADDRESS_LINE5,
        e.ADDRESS_LINE6,
        e.ADDRESS_LINE7,
        NULL AS POSTCODE,
        NULL AS COUNTRY_CODE,
