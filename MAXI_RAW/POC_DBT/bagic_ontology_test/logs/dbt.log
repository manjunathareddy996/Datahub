create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_mmbr_dtls
         as
        (

-- Satellite Partner Member Details
-- Hub: hub_prtnr_role (member enrollment data per role)
-- Source: SIMPLE_PROPERTY_PIVOT
-- Domain: Age, BMI, sum insured, premium, cover, health card

WITH multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.FOREIGN_KEY
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE pd.PARTY_CODE IS NOT NULL
      AND ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(sp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ms.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        sp.PARTY_CODE,
        ms.STAKE_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.STATUS AS status,

        -- Member demographics
        sp.AGE,
        sp.BMI,
        sp.HEIGHT,
        sp.WEIGHT,
        sp.BLOOD_GROUP,

        -- Insurance coverage
        sp.SUM_INSURED,
        sp.SUM_INSURED_TYPE,
        sp.PREMIUM,
        sp.PREMIUM_AMOUNT,
        sp.COVER_TYPE,
        sp.COVER_START_DATE,
        sp.COVER_END_DATE,
        sp.COVER_PERIOD,

        -- Health card
        sp.HEALTH_CARD_NUMBER,
        sp.HEALTH_CARD_ISSUE_DATE,
        sp.HEALTH_CARD_VALID_TILL,
        sp.HEALTH_CARD_STATUS,

        -- Member classification
        sp.MEMBER_TYPE,
        sp.MEMBER_STATUS,
        sp.MEMBER_CODE,

        -- Add remaining columns from 03_SATELLITES.csv for full implementation

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.AGE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.BMI AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.SUM_INSURED AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PREMIUM AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.COVER_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.HEALTH_CARD_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.HEALTH_CARD_STATUS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MEMBER_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MEMBER_STATUS AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp
    INNER JOIN multi_set ms ON sp.PARTY_CODE = ms.PARTY_CODE
)



SELECT * FROM source


