 AS hk_prpsr_cd,
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_trvl_plcy_pd_proposer_details
    WHERE PARTY_CODE IS NOT NULL
),



new_records AS (
    SELECT
        hk_prpsr_cd,
        PROPOSER_CODE AS prpsr_cd,
        ld_dt_tm,
        rcrd_src_nm
    FROM source
    
)

SELECT * FROM new_records
        );
