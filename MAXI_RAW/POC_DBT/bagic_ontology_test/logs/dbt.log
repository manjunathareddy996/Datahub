create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.lnk_clm_prtnr
         as
        (

-- Link Claim to Partner
-- Connects hub_clm to hub_prtnr_mstr (partner involvement in a claim)
-- Sources: OPUS (CLM_INTERESTED_PARTIES) — MAXIMUS claim-partner link TBD

WITH opus_source AS (
    SELECT
        PART_ID,
        CLAIM_ID,
        IP_TYPE,
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(PART_ID AS VARCHAR), ''))))
    
 AS hk_prtnr_mstr_cd,
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(CLAIM_ID AS VARCHAR), ''))))
    
 AS hk_clm_cd,
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(CLAIM_ID AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(PART_ID AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(IP_TYPE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_lnk_clm_prtnr,
        load_dt_tm AS ld_dt_tm,
        record_source AS rcrd_src_nm
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_clm_interested_parties
),



new_records AS (
    SELECT DISTINCT
        hk_lnk_clm_prtnr,
        hk_clm_cd,
        hk_prtnr_mstr_cd,
        IP_TYPE AS ip_type,
        ld_dt_tm,
        rcrd_src_nm
    FROM opus_source
    
)

SELECT * FROM new_records
        );
