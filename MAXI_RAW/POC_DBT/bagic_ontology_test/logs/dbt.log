        NULL AS EVALUATION_LIMIT,

        -- FOSFEET (Federation of Surveyors)
        msp.FOSFEET_ON_STREET AS FOSFEET_MEMBERSHIP,
        NULL AS FOSFEET_NUMBER,

        -- Staff / Equipment
        NULL AS STAFF_STRENGTH_TECHNICAL,
        NULL AS STAFF_STRENGTH_CLERICAL,
        msp.STAFF_STRENGTH_TOTAL,
        msp.NO_OF_COMPUTERSTOTAL AS NO_OF_COMPUTERS,
        msp.NO_OF_PRINTERSTOTAL AS NO_OF_PRINTERS,

        -- Metadata
        msp.load_dt_tm AS ld_dt_tm,
        msp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(msp.TYPE_OF_SURVEYOR AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.SUR_LICENSE_NO AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.STAFF_STRENGTH_TOTAL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.NO_OF_COMPUTERSTOTAL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.NO_OF_PRINTERSTOTAL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.FOSFEET_ON_STREET AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property msp
    INNER JOIN hub_role h
        ON msp.PARTY_CODE = h.prty_id
        AND msp.STAKE_CODE = h.stake_cd
)



