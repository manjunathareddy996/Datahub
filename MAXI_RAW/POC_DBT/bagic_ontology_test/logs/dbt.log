create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_lgl_advct_dtls
         as
        (

-- Satellite Partner Legal Advocate Details
-- Hub: hub_prtnr_role (legal/advocate attributes per role)
-- Sources: MAXIMUS (simple property) + OPUS (clm_supplier_extn - LAWYER_TYPE discriminator)

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
    WHERE stake_cd IN ('ADVOCATE', 'LAWYER')
),

maximus_source AS (
    SELECT
        h.hk_prtnr_role_cd,
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,
        
        -- Lawyer classification
        sp.TYPE_OF_LAWYER AS lawyer_type,
        NULL AS lawyer_category,
        NULL AS lawyer_specialization,
        
        -- Bar association
        sp.BAR_ASSOCIATION_NAMELAWYER AS bar_association_name,
        NULL AS bar_association_number,
        NULL AS bar_association_state,
        NULL AS bar_council_registration,
        
        -- Court details
        sp.COURT_NAME AS court_name,
        NULL AS court_type,
        NULL AS court_jurisdiction,
        
        -- Enrolment
        sp.ENROLMENT_NOLAWYER AS enrolment_no,
        sp.DATE_OF_JOININGLAWYER AS enrolment_date,
        NULL AS enrolment_state,
        
        -- Case volume metrics
        sp.NO_OF_BRIEFS AS no_of_briefs,
        NULL AS no_of_companies,
        NULL AS no_of_mact,
        NULL AS no_of_wc,
        
        -- OPUS-only
        NULL AS covered_court_loc,
        NULL AS yr_experience,
        NULL AS date_of_joining,
        NULL AS no_of_consumer,
        NULL AS no_of_junior,
        NULL AS acd_qualification,
        NULL AS internet_access,
        NULL AS access_online_journal,
        NULL AS availability_library
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp
    INNER JOIN hub_role h 
        ON h.prty_id = CAST(sp.PARTY_CODE AS VARCHAR)
    WHERE sp.TYPE_OF_LAWYER IS NOT NULL
),

opus_source AS (
    SELECT
        h.hk_prtnr_role_cd,
        ocs.load_dt_tm AS ld_dt_tm,
        ocs.record_source AS rcrd_src_nm,
        
        ocs.LAWYER_TYPE AS lawyer_type,
        NULL AS lawyer_category,
        NULL AS lawyer_specialization,
        ocs.BAR_ASSOCIATION_NAME AS bar_association_name,
        NULL AS bar_association_number,
        NULL AS bar_association_state,
        NULL AS bar_council_registration,
        ocs.COVERED_COURT_LOC AS court_name,
        NULL AS court_type,
        NULL AS court_jurisdiction,
        ocs.ENROLMENT_NO AS enrolment_no,
        NULL AS enrolment_date,
        NULL AS enrolment_state,
        ocs.NO_OF_BRIEFS AS no_of_briefs,
        ocs.NO_OF_COMPANIES AS no_of_companies,
        ocs.NO_OF_MACT AS no_of_mact,
        ocs.NO_OF_WC AS no_of_wc,
        
        -- OPUS-only
        ocs.COVERED_COURT_LOC AS covered_court_loc,
        ocs.YR_EXPERIENCE AS yr_experience,
        ocs.DATE_OF_JOINING AS date_of_joining,
        ocs.NO_OF_CONSUMER AS no_of_consumer,
        ocs.NO_OF_JUNIOR AS no_of_junior,
        ocs.ACD_QUALIFICATION AS acd_qualification,
        ocs.INTERNET_ACCESS AS internet_access,
        ocs.ACCESS_ONLINE_JOURNAL AS access_online_journal,
        ocs.AVAILABILITY_LIBRARY AS availability_library
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_clm_supplier_extn ocs
    INNER JOIN hub_role h 
        ON 
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(ocs.PART_ID AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(ocs.SUPP_ID AS VARCHAR), '')))
                
                
            )
        )
    
 = h.hk_prtnr_role_cd
    WHERE ocs.LAWYER_TYPE IS NOT NULL
       OR ocs.BAR_ASSOCIATION_NAME IS NOT NULL
       OR ocs.ENROLMENT_NO IS NOT NULL
),

combined AS (
    SELECT *, 
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(lawyer_type AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(bar_association_name AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(enrolment_no AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(court_name AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(no_of_briefs AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
    FROM maximus_source
    UNION ALL
    SELECT *, 
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(lawyer_type AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(bar_association_name AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(enrolment_no AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(court_name AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(no_of_briefs AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
    FROM opus_source
)



SELECT * FROM combined


        );
