            ,
            
            UPPER(TRIM(COALESCE(CAST(oh.VERSION AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
        
    FROM hub_mstr h
    INNER JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_address_hist oh
        ON h.prty_id = oh.PART_ID
),

combined AS (
    SELECT * FROM maximus_source
    UNION ALL
    SELECT * FROM opus_address
    UNION ALL
