         as
        (

-- Satellite Partner Agent Details
-- Hub: hub_prtnr_role (agent-specific attributes per role)
-- Source: MULTI_SET_PROPERTY_PIVOT (role-specific attributes)
-- Domain: Branch, license, IRDA, channel, intermediary details

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        PRTY_ID,
        STAKE_CD
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

party_detail AS (
    SELECT FOREIGN_KEY, PARTY_CODE
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL
    WHERE PARTY_CODE IS NOT NULL
),

multi_set AS (
    SELECT
        pd.PARTY_CODE,
        ms.STAKE_CODE,
        ms.BRANCH_CODE,
        ms.BRANCH_NAME,
        ms.BRANCH,
        ms.LICENSE_NUMBER,
        ms.LICENSE_ISSUE_DATE,
        ms.LICENSE_EXPIRY_DATE,
        ms.IRDA_CODE,
        ms.AGENT_CHANNEL,
        ms.SUB_CHANNEL,
        ms.INTERMEDIARY_TYPE,
        ms.EMPLOYEE_STATUS
    FROM party_detail pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 ms
        ON pd.FOREIGN_KEY = ms.FOREIGN_KEY
    WHERE ms.STAKE_CODE IS NOT NULL
      AND ms.STAKE_CODE != ''
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        h.PRTY_ID,
        h.STAKE_CD,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.PARTY_STATUS AS status,

        -- Branch details (from multi-set)
        ms.BRANCH_CODE,
        ms.BRANCH_NAME,
        ms.BRANCH AS BRANCH_OFFICE,
        NULL AS BRANCH_STATE,

        -- License / IRDA (from multi-set)
        ms.LICENSE_NUMBER,
        ms.LICENSE_ISSUE_DATE AS LICENSE_VALID_FROM,
        ms.LICENSE_EXPIRY_DATE AS LICENSE_VALID_TO,
        ms.IRDA_CODE AS IRDA_LICENSE_NUMBER,
        NULL AS IRDA_LICENSE_VALID_FROM,
        NULL AS IRDA_LICENSE_VALID_TO,

        -- Channel / Intermediary (from multi-set)
        ms.AGENT_CHANNEL AS CHANNEL,
        ms.SUB_CHANNEL,
        NULL AS INTERMEDIARY_CODE,
        NULL AS INTERMEDIARY_NAME,
        ms.INTERMEDIARY_TYPE,

        -- Agent classification (from multi-set)
        NULL AS AGENT_CODE,
        NULL AS AGENT_TYPE,
        ms.EMPLOYEE_STATUS AS AGENT_STATUS,
        NULL AS AGENT_CATEGORY,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(ms.BRANCH_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ms.LICENSE_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ms.IRDA_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ms.AGENT_CHANNEL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ms.SUB_CHANNEL AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ms.INTERMEDIARY_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ms.EMPLOYEE_STATUS AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_role h
    INNER JOIN multi_set ms 
        ON h.PRTY_ID = ms.PARTY_CODE 
        AND h.STAKE_CD = ms.STAKE_CODE
    LEFT JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON h.PRTY_ID = sp.PARTY_CODE
)



