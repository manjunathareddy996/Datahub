        NULL AS FROM_DATE,
        
        -- Metadata
        e.load_dt_tm AS ld_dt_tm,
        e.record_source AS rcrd_src_nm,
        
        -- Hash diff
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(e.ADD_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(e.ADD_TYPE AS VARCHAR), '')))
