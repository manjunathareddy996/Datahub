),
v_final AS (
    SELECT
        FOREIGN_KEY AS part_id,
        MAX(CASE WHEN PARAM_NAME = 'IFSC' THEN PARAM_VALUE END) AS ifsc_cd,
        MAX(CASE WHEN PARAM_NAME = 'MICR' THEN PARAM_VALUE END) AS micr_cd,
        'MAXIMUS' AS rcrd_src_nm
    FROM v_partyProperty_partyProperty_multiSetProperty_multiSetDetail_property
    GROUP BY FOREIGN_KEY
)
SELECT * FROM v_final;
