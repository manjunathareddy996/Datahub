create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_emply_dtls
         as
        (

-- Satellite Partner Employee Details
-- Hub: hub_prtnr_role (employee-specific attributes per role)
-- Source: stg_partner_multiset_property
-- Domain: Employee code, user details, acceptance/issue/submission dates

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        msp.PARTY_CODE,
        msp.STAKE_CODE,

        -- Semantic reference columns
        msp.TYPE_OF_PARTY AS partner_type,
        msp.PARTY_STATUS AS status,

        -- Employee identification
        msp.EMPLOYEE_CODE,
        msp.EMPLOYEE_ID,
        msp.EMPLOYEE_NAME,
        msp.EMPLOYEE_TYPE,
        msp.EMPLOYEE_STATUS,
        msp.EMPLOYEE_DESIGNATION,
        msp.EMPLOYEE_DEPARTMENT,

        -- User details
        msp.USER_ID,
        msp.USER_NAME,
        msp.USER_TYPE,
        msp.USER_STATUS,

        -- Key dates
        msp.DATE_OF_ACCEPTANCE,
        msp.DATE_OF_ISSUE,
        msp.DATE_OF_SUBMITTING,
        msp.DATE_OF_JOINING,
        msp.DATE_OF_LEAVING,

        -- Metadata
        msp.load_dt_tm AS ld_dt_tm,
        msp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(msp.EMPLOYEE_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.EMPLOYEE_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.EMPLOYEE_STATUS AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.EMPLOYEE_DESIGNATION AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.USER_ID AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.DATE_OF_ACCEPTANCE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.DATE_OF_JOINING AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.DATE_OF_LEAVING AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property msp
    INNER JOIN hub_role h
        ON msp.PARTY_CODE = h.prty_id
        AND msp.STAKE_CODE = h.stake_cd
)



SELECT * FROM source


        );
