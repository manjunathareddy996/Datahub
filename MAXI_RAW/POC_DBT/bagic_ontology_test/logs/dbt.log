create or replace  temporary view BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.lnk_prtnr_mstr_role__dbt_tmp
  
   as (
    

-- Link Partner Master to Role
-- Connects hub_prtnr_mstr to hub_prtnr_role (1:N relationship)
-- Proper Data Vault: Built from hubs, not source tables

WITH hub_mstr AS (
    SELECT 
        hk_prtnr_mstr_cd,
        prty_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_mstr
),

hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

source AS (
    SELECT
        m.hk_prtnr_mstr_cd,
        r.hk_prtnr_role_cd,
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(m.hk_prtnr_mstr_cd AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(r.hk_prtnr_role_cd AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_lnk_prtnr_mstr_role,
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm
    FROM hub_role r
    INNER JOIN hub_mstr m 
        ON r.prty_id = m.prty_id
),


existing AS (
    SELECT hk_lnk_prtnr_mstr_role
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.lnk_prtnr_mstr_role
),


new_records AS (
    SELECT DISTINCT
        hk_lnk_prtnr_mstr_role,
        hk_prtnr_mstr_cd,
        hk_prtnr_role_cd,
        ld_dt_tm,
        rcrd_src_nm
    FROM source
    
    WHERE hk_lnk_prtnr_mstr_role NOT IN (SELECT hk_lnk_prtnr_mstr_role FROM existing)
    
)

SELECT * FROM new_records
  );
