-- Connects hub_prtnr_mstr to hub_dcmnt
-- Sources: MAXIMUS (document_detail via party_detail) — OPUS does not have a document table

WITH hub_prtnr_mstr AS (
    SELECT 
        hk_prtnr_mstr_cd,
        prty_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_mstr
),

source AS (
    SELECT
        pm.hk_prtnr_mstr_cd,
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(dd.ROOT_HASH AS VARCHAR), ''))))
    
 AS hk_dcmnt_cd,
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(pm.prty_id AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(dd.ROOT_HASH AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_lnk_prtnr_dcmnt,
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_detail pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_DOCUMENT_DETAIL dd
        ON pd.FOREIGN_KEY = dd.FOREIGN_KEY
    INNER JOIN hub_prtnr_mstr pm ON pd.PARTY_CODE = pm.prty_id
    WHERE pd.PARTY_CODE IS NOT NULL
      AND dd.ROOT_HASH IS NOT NULL
),



new_records AS (
    SELECT DISTINCT
        hk_lnk_prtnr_dcmnt,
        hk_prtnr_mstr_cd,
        hk_dcmnt_cd,
        ld_dt_tm,
        rcrd_src_nm
    FROM source
    
)

