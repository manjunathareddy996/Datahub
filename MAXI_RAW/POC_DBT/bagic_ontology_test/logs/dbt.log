create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_dlr_rprr_dtls
         as
        (

-- Satellite Partner Dealer Repairer Details
-- Hub: hub_prtnr_role (dealer/repairer attributes per role)
-- Source: stg_partner_simple_property (business columns) + stg_partner_multiset_property (role mapping)
-- Domain: Dealer, repairer, automobile, labor rate, cash back

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        msp.PARTY_CODE,
        msp.STAKE_CODE,

        -- Semantic reference columns
        msp.TYPE_OF_PARTY AS partner_type,
        msp.PARTY_STATUS AS status,

        -- Dealer details
        sp.DEALER_CODE,
        sp.DEALER_NAME,
        sp.DEALER_TYPE,
        sp.DEALER_CATEGORY,
        sp.DEALER_MAKE,

        -- Repairer details
        sp.REPAIRER_CODE,
        sp.REPAIRER_NAME,
        sp.REPAIRER_TYPE,
        sp.REPAIRER_CATEGORY,

        -- Automobile
        sp.AUTOMOBILE_MAKE,
        sp.AUTOMOBILE_MODEL,
        sp.AUTOMOBILE_TYPE,

        -- Rates / Financials
        sp.LABOR_RATE,
        sp.LABOR_RATE_PER_HOUR,
        sp.CASH_BACK_PERCENTAGE,
        sp.CASH_BACK_AMOUNT,
        sp.CASH_BACK_APPLICABLE,

        -- Metadata
        msp.load_dt_tm AS ld_dt_tm,
        msp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.DEALER_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.DEALER_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.REPAIRER_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.REPAIRER_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.AUTOMOBILE_MAKE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.LABOR_RATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.CASH_BACK_PERCENTAGE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.CASH_BACK_APPLICABLE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property msp
    INNER JOIN hub_role h
        ON msp.PARTY_CODE = h.prty_id
        AND msp.STAKE_CODE = h.stake_cd
    INNER JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp
        ON msp.PARTY_CODE = sp.PARTY_CODE
)



