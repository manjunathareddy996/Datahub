 AS hk_plcy_cd,
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_trvl_plcy_policy_details
    WHERE POLICY_NUMBER IS NOT NULL
),



new_records AS (
    SELECT
        hk_plcy_cd,
        POLICY_NUMBER AS plcy_nbr,
        ld_dt_tm,
        rcrd_src_nm
    FROM source
    
)

SELECT * FROM new_records
        );
