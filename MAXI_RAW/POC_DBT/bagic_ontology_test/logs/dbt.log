create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_mmbr_dtls
         as
        (

-- Satellite Partner Member Details
-- Hub: hub_prtnr_role (member enrollment data per role)
-- Source: SIMPLE_PROPERTY_PIVOT + MULTI_SET_PROPERTY
-- Domain: Age, BMI, sum insured, premium, cover, health card

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

multi_set AS (
    SELECT
        PARTY_CODE,
        STAKE_CODE,
        hk_prtnr_role_cd,
        TYPE_OF_PARTY,
        PARTY_STATUS
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        h.prty_id AS PARTY_CODE,
        h.stake_cd AS STAKE_CODE,

        -- Semantic reference columns
        ms.TYPE_OF_PARTY AS partner_type,
        ms.PARTY_STATUS AS status,

        -- Member demographics
        sp.AGE,
        NULL AS BMI,
        sp.HEIGHT,
        sp.WEIGHT,
        NULL AS BLOOD_GROUP,

        -- Insurance coverage
        NULL AS SUM_INSURED,
        NULL AS SUM_INSURED_TYPE,
        NULL AS PREMIUM,
        NULL AS PREMIUM_AMOUNT,
        NULL AS COVER_TYPE,
        NULL AS COVER_START_DATE,
        NULL AS COVER_END_DATE,
        NULL AS COVER_PERIOD,

        -- Health card
        NULL AS HEALTH_CARD_NUMBER,
        NULL AS HEALTH_CARD_ISSUE_DATE,
        NULL AS HEALTH_CARD_VALID_TILL,
        NULL AS HEALTH_CARD_STATUS,

        -- Member classification
        sp.MEMBER_TYPE,
        NULL AS MEMBER_STATUS,
        NULL AS MEMBER_CODE,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.AGE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.HEIGHT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.WEIGHT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.MEMBER_TYPE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_role h
    INNER JOIN multi_set ms 
        ON h.prty_id = ms.PARTY_CODE 
        AND h.stake_cd = ms.STAKE_CODE
    LEFT JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON h.prty_id = sp.PARTY_CODE
)



