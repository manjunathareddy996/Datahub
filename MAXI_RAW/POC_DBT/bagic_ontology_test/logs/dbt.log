    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_mstr
),

source AS (
    SELECT
        h.hk_prtnr_mstr_cd,
        h.prty_id AS PARTY_CODE,

        -- Semantic reference columns
        sp.TYPE_OF_PARTY AS partner_type,
        sp.PARTY_STATUS AS status,

        -- Branch details
        sp.BRANCH_CODE,
        sp.BRANCH_NAME,
        sp.BRANCH AS BRANCH_OFFICE,
        NULL AS BRANCH_STATE,

        -- License / IRDA
        sp.LICENSE_NUMBER,
        sp.LICENSE_ISSUE_DATE AS LICENSE_VALID_FROM,
        sp.LICENSE_EXPIRY_DATE AS LICENSE_VALID_TO,
        sp.IRDA_CODE AS IRDA_LICENSE_NUMBER,
        NULL AS IRDA_LICENSE_VALID_FROM,
