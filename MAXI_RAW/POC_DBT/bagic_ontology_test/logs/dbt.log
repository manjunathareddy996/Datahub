create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_hsptl_infra_dtls
         as
        (

-- Satellite Partner Hospital Infrastructure Details
-- Hub: hub_prtnr_role (HOSPITAL role)
-- Sources: MAXIMUS (simple property) + OPUS (BJAZ_HM_HOSPITAL_MASTER)

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

maximus_source AS (
    SELECT
        h.hk_prtnr_role_cd,
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,
        
        -- Hospital fields from MAXIMUS
        sp.HOSPITAL_NAME AS hospital_name,
        sp.HOSPITAL_SPECIALITY AS hospital_type,
        sp.PROVIDER_CATEGORY AS network_type,
        sp.ONLINE_HOSPITAL_REFERENCE_NUMBER AS hosid,
        
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.HOSPITAL_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.HOSPITAL_SPECIALITY AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.NETWORK_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.ONLINE_HOSPITAL_REFERENCE_NUMBER AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp
    INNER JOIN hub_role h 
        ON h.prty_id = CAST(sp.PARTY_CODE AS VARCHAR)
    WHERE sp.HOSPITAL_NAME IS NOT NULL
),

opus_source AS (
    SELECT
        h.hk_prtnr_role_cd,
        ohm.load_dt_tm AS ld_dt_tm,
        ohm.record_source AS rcrd_src_nm,
        
        ohm.HOSPITAL_NAME AS hospital_name,
        ohm.HOSP_TYPE AS hospital_type,
        ohm.NETWORK_TYPE AS network_type,
        ohm.HOSID AS hosid,
        
        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(ohm.HOSPITAL_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ohm.HOSP_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(ohm.NETWORK_TYPE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_hospital_master ohm
    INNER JOIN hub_role h 
        ON h.prty_id = CAST(ohm.PART_ID AS VARCHAR)
),

combined AS (
    SELECT * FROM maximus_source
    UNION ALL
    SELECT * FROM opus_source
)



SELECT * FROM combined


        );
