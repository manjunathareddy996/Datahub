create or replace   view BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property
  
   as (
    

-- Staging: Multi-set property pivot (role-specific attributes)
-- Source: BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1
-- This contains attributes that vary by partner role (STAKE_CODE)

WITH source AS (
    SELECT *
    FROM BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1
    WHERE STAKE_CODE IS NOT NULL
      AND STAKE_CODE != ''
),

-- Join to get PARTY_CODE
party_detail AS (
    SELECT 
        PARTY_CODE,
        FOREIGN_KEY,
        TYPE_OF_PARTY,
        PARTY_STATUS
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_detail
),

staged AS (
    SELECT
        pd.PARTY_CODE,
        pd.TYPE_OF_PARTY,
        pd.PARTY_STATUS,
        
        -- Hash keys
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(pd.PARTY_CODE AS VARCHAR), ''))))
    
 AS hk_prtnr_mstr_cd,
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(pd.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(src.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        
        -- Role identifier
        src.STAKE_CODE,
        
        -- All business columns from multi-set pivot
        src.* EXCLUDE (FOREIGN_KEY, INC_JOB_CREATED_AT, REC_REFRESH_AT),
        
        -- Metadata
        src.FOREIGN_KEY,
        src.INC_JOB_CREATED_AT,
        src.REC_REFRESH_AT,
        CURRENT_TIMESTAMP() AS load_dt_tm,
        'MAXIMUS' AS record_source
        
    FROM source src
    INNER JOIN party_detail pd ON src.FOREIGN_KEY = pd.FOREIGN_KEY
)

SELECT * FROM staged
  );
