create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_insrd
         as
        (

-- Hub Insured: One row per unique insured member
-- Business Key: MEMBER_CODE (from memberDetails within health policy)
-- Sources: MAXIMUS Health Policy (member_details)

WITH source AS (
    SELECT DISTINCT
        PARTY_CODE AS MEMBER_CODE,
        
    
        MD5(UPPER(TRIM(COALESCE(CAST(PARTY_CODE AS VARCHAR), ''))))
    
 AS hk_insrd_cd,
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_trvl_plcy_pd_id_member_details
    WHERE PARTY_CODE IS NOT NULL
),



new_records AS (
    SELECT
        hk_insrd_cd,
        MEMBER_CODE AS insrd_cd,
        ld_dt_tm,
        rcrd_src_nm
    FROM source
    
)

SELECT * FROM new_records
        );
