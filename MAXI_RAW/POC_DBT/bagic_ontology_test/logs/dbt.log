        msp.TDS_RATE,
        msp.TDS_SECTION_CODE
        
    FROM party_detail pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_PARTY_PROPERTY_MULTI_SET_PROPERTY_MULTI_SET_DETAIL_PROPERTY_PIVOT_VW_2_1 msp
        ON pd.FOREIGN_KEY = msp.FOREIGN_KEY
    WHERE msp.STAKE_CODE IS NOT NULL
      AND msp.STAKE_CODE != ''
),

simple_property AS (
    SELECT
        pd.PARTY_CODE,
        sp.PAYMENT_MODE,
        sp.PAYMENT_METHOD,
        sp.EMANDATE_DETAILS,
        sp.CREDIT_LIMIT,
        sp.CREDIT_DAYS
    FROM party_detail pd
    INNER JOIN BAGIC_PREPROD_CURATED_DB.UTILS.stg_partner_simple_property sp
        ON pd.PARTY_CODE = sp.PARTY_CODE
),

source AS (
    SELECT
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(msp.PARTY_CODE AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(msp.STAKE_CODE AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_prtnr_role_cd,
        msp.PARTY_CODE,
        msp.STAKE_CODE,

        -- Semantic reference columns
        msp.TYPE_OF_PARTY AS partner_type,
        msp.PARTY_STATUS AS status,

        -- Bank account details
        msp.ACCOUNT_HOLDER_NAME,
        msp.ACCOUNT_NUMBER,
        msp.ACCOUNT_TYPE,
        msp.BANK_ACCOUNT_NUMBER,
        msp.BANK_BRANCH_NAME AS BANK_BRANCH,
        NULL AS BANK_CITY,
        msp.BANK_NAME,
        msp.IFSC AS IFSC_CODE,
        msp.MICR AS MICR_CODE,

        -- Payment details
        sp.PAYMENT_MODE,
        sp.PAYMENT_METHOD AS PAYMENT_TYPE,
        sp.EMANDATE_DETAILS,
        msp.MANDATE_AMOUNT,
        msp.MANDATE_REGISTERED_ON AS MANDATE_DATE,
        NULL AS MANDATE_NUMBER,
        NULL AS MANDATE_STATUS,
        NULL AS MANDATE_TYPE,

        -- Credit / TDS
        sp.CREDIT_LIMIT,
        sp.CREDIT_DAYS AS CREDIT_PERIOD,
        NULL AS TDS_APPLICABLE,
        msp.TDS_RATE AS TDS_PERCENTAGE,
        msp.TDS_SECTION_CODE AS TDS_SECTION,

        -- Metadata
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(msp.ACCOUNT_NUMBER AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.BANK_NAME AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.IFSC AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.MICR AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.PAYMENT_MODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.CREDIT_LIMIT AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(msp.TDS_RATE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM multi_set_property msp
    LEFT JOIN simple_property sp ON msp.PARTY_CODE = sp.PARTY_CODE
)



