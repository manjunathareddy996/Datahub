create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.sat_prtnr_dlr_rprr_dtls
         as
        (

-- Satellite Partner Dealer Repairer Details
-- Hub: hub_prtnr_role (dealer/repairer attributes per role)
-- Source: SIMPLE_PROPERTY_PIVOT + MULTI_SET_PROPERTY
-- Domain: Dealer, repairer, automobile, labor rate, cash back

WITH hub_role AS (
    SELECT 
        hk_prtnr_role_cd,
        prty_id,
        stake_cd
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_role
),

multi_set AS (
    SELECT
        PARTY_CODE,
        STAKE_CODE,
        hk_prtnr_role_cd,
        TYPE_OF_PARTY,
        PARTY_STATUS
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_multiset_property
),

source AS (
    SELECT
        h.hk_prtnr_role_cd,
        h.prty_id AS PARTY_CODE,
        h.stake_cd AS STAKE_CODE,

        -- Semantic reference columns
        ms.TYPE_OF_PARTY AS partner_type,
        ms.PARTY_STATUS AS status,

        -- Dealer details
        sp.DEALER_CODE,
        sp.DEALER_NAME,
        sp.DEALER_TYPE,
        sp.DEALER_CATEGORY,
        sp.DEALER_MAKE,

        -- Repairer details
        sp.REPAIRER_CODE,
        sp.REPAIRER_NAME,
        sp.REPAIRER_TYPE,
        sp.REPAIRER_CATEGORY,

        -- Automobile
        sp.AUTOMOBILE_MAKE,
        sp.AUTOMOBILE_MODEL,
        sp.AUTOMOBILE_TYPE,

        -- Rates / Financials
        sp.LABOR_RATE,
        sp.LABOR_RATE_PER_HOUR,
        sp.CASH_BACK_PERCENTAGE,
        sp.CASH_BACK_AMOUNT,
        sp.CASH_BACK_APPLICABLE,

        -- Metadata
        sp.load_dt_tm AS ld_dt_tm,
        sp.record_source AS rcrd_src_nm,

        
    MD5(
        CONCAT_WS('||',
            
            UPPER(TRIM(COALESCE(CAST(sp.DEALER_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.DEALER_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.REPAIRER_CODE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.REPAIRER_TYPE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.AUTOMOBILE_MAKE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.LABOR_RATE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.CASH_BACK_PERCENTAGE AS VARCHAR), '')))
            ,
            
            UPPER(TRIM(COALESCE(CAST(sp.CASH_BACK_APPLICABLE AS VARCHAR), '')))
            
            
        )
    )
 AS rcrd_hsh_id

    FROM hub_role h
    INNER JOIN multi_set ms 
        ON h.prty_id = ms.PARTY_CODE 
        AND h.stake_cd = ms.STAKE_CODE
    LEFT JOIN BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_simple_property sp 
        ON h.prty_id = sp.PARTY_CODE
)



