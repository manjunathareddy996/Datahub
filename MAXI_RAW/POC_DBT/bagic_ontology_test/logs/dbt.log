create or replace transient table BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.lnk_prtnr_rltn
         as
        (

-- Link Partner Relation (Self-referencing)
-- Connects hub_prtnr_mstr to hub_prtnr_mstr (partner related to partner)
-- Sources: MAXIMUS (related_party table) — OPUS has parent/child via AZBJ_PARTNER_EXTN.PARENT_ID

WITH hub_prtnr_mstr AS (
    SELECT 
        hk_prtnr_mstr_cd,
        prty_id
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.hub_prtnr_mstr
),

maximus_source AS (
    SELECT
        pm_from.hk_prtnr_mstr_cd AS hk_prtnr_mstr_from,
        pm_to.hk_prtnr_mstr_cd AS hk_prtnr_mstr_to,
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(pm_from.prty_id AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(pm_to.prty_id AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_lnk_prtnr_rltn,
        CURRENT_TIMESTAMP() AS ld_dt_tm,
        'MAXIMUS' AS rcrd_src_nm
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_partner_detail pd
    INNER JOIN BAGIC_PROD_MIRROR_DB.MAXI_RAW.BUSINESS_PARTNERS_VW_DATA_PARTY_DETAIL_RELATED_PARTY rp
        ON pd.FOREIGN_KEY = rp.FOREIGN_KEY
    INNER JOIN hub_prtnr_mstr pm_from ON pd.PARTY_CODE = pm_from.prty_id
    INNER JOIN hub_prtnr_mstr pm_to ON rp.ROOT_HASH = pm_to.prty_id
    WHERE pd.PARTY_CODE IS NOT NULL
      AND rp.ROOT_HASH IS NOT NULL
),

-- OPUS: parent-child relationship from AZBJ_PARTNER_EXTN.PARENT_ID
opus_source AS (
    SELECT
        pm_from.hk_prtnr_mstr_cd AS hk_prtnr_mstr_from,
        pm_to.hk_prtnr_mstr_cd AS hk_prtnr_mstr_to,
        
    
        MD5(
            CONCAT_WS('||',
                
                UPPER(TRIM(COALESCE(CAST(pm_from.prty_id AS VARCHAR), '')))
                ,
                
                UPPER(TRIM(COALESCE(CAST(pm_to.prty_id AS VARCHAR), '')))
                
                
            )
        )
    
 AS hk_lnk_prtnr_rltn,
        ope.load_dt_tm AS ld_dt_tm,
        ope.record_source AS rcrd_src_nm
    FROM BAGIC_PREPROD_CURATED_DB.BGIL_DEV_DATA_MODEL.stg_opus_partner_extn ope
    INNER JOIN hub_prtnr_mstr pm_from ON CAST(ope.PART_ID AS VARCHAR) = pm_from.prty_id
    INNER JOIN hub_prtnr_mstr pm_to ON ope.PARENT_ID = pm_to.prty_id
    WHERE ope.PARENT_ID IS NOT NULL
      AND ope.PARENT_ID != ''
),

source AS (
    SELECT hk_lnk_prtnr_rltn, hk_prtnr_mstr_from, hk_prtnr_mstr_to, ld_dt_tm, rcrd_src_nm FROM maximus_source
    UNION ALL
    SELECT hk_lnk_prtnr_rltn, hk_prtnr_mstr_from, hk_prtnr_mstr_to, ld_dt_tm, rcrd_src_nm FROM opus_source
),



new_records AS (
    SELECT DISTINCT
        hk_lnk_prtnr_rltn,
        hk_prtnr_mstr_from,
        hk_prtnr_mstr_to,
        ld_dt_tm,
        rcrd_src_nm
    FROM source
    
)

SELECT * FROM new_records
        );
