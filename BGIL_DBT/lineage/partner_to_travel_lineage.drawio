<mxfile host="app.diagrams.net"><diagram id="p2t" name="Partner to Travel lineage"><mxGraphModel dx="800" dy="485" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="970" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Use case:&lt;/b&gt; A partner (party) is known to BAGIC. Find out whether, and how, this party is involved in TRAVEL: bought a policy (proposer / payer), is insured (member), or claimed." style="text;html=1;whiteSpace=wrap;align=center;fontSize=14;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1560" height="36" as="geometry"/></mxCell><mxCell id="l1" value="1. PARTNER SIDE" style="swimlane;horizontal=0;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#eef4fd;fontStyle=1;fontSize=14;strokeWidth=2;startSize=30;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="1560" height="150" as="geometry"/></mxCell><mxCell id="l2" value="2. IDENTITY RESOLUTION" style="swimlane;horizontal=0;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#eef7ec;fontStyle=1;fontSize=14;strokeWidth=2;startSize=30;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="20" y="235" width="1560" height="215" as="geometry"/></mxCell><mxCell id="l3" value="3. TRAVEL INVOLVEMENT" style="swimlane;horizontal=0;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fff6ea;fontStyle=1;fontSize=14;strokeWidth=2;startSize=30;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1560" height="230" as="geometry"/></mxCell><mxCell id="l4" value="4. POLICY AND PRODUCT" style="swimlane;horizontal=0;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#fdeeed;fontStyle=1;fontSize=14;strokeWidth=2;startSize=30;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1560" height="110" as="geometry"/></mxCell><mxCell id="p0" value="Partner arrives&lt;br&gt;(party code / part_id / PAN / mobile / email)" style="ellipse;whiteSpace=wrap;html=1;align=center;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="70" y="80" width="200" height="100" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;OPUS_PARTNER&lt;/b&gt; HUB_PARTY&lt;br&gt;BK = CP_PARTNERS.part_id&lt;br&gt;NK = 'HUB_PARTY|'||part_id" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="340" y="70" width="250" height="58" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;MAXIMUS_PARTNER&lt;/b&gt; HUB_PARTY&lt;br&gt;BK = party_code&lt;br&gt;NK = 'HUB_PARTY|'||party_code" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="340" y="135" width="250" height="58" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Partner attributes&lt;/b&gt; (latest per PARTY_HKEY)&lt;br&gt;SAT_PARTY_IDENTIFICATION: PAN, AADHAAR, PASSPORT, GSTIN, CKYC&lt;br&gt;SAT_COMMON_CONTACT: MOBILE, EMAIL&lt;br&gt;SAT_PARTY_IDENTITY: NAME, DOB, GENDER&lt;br&gt;SAT_LNK_PARTY_ROLE_CORE: partner roles" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="670" y="67" width="470" height="128" as="geometry"/></mxCell><mxCell id="p4" value="Shared physical tables in BGIL_DATA_MODEL: one HUB_PARTY and one set of SATs written by all 4 projects (use RECORD_SOURCE to tell them apart)" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="1190" y="80" width="360" height="100" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Tier 1: same source key&lt;/b&gt;&lt;br&gt;Opus: part_id (partner) = part_id / premiumpayerid / payer_part_id / cft_mst_comp_ref (travel)&lt;br&gt;Maximus: party_code (partner) = party_code / w0_party_code (travel)&lt;br&gt;Same PARTY_HKEY, plain join" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="70" y="255" width="430" height="115" as="geometry"/></mxCell><mxCell id="d2" value="Same PARTY_HKEY found in travel?" style="rhombus;whiteSpace=wrap;html=1;align=center;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="565" y="255" width="200" height="115" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Tier 2: cross-system (Opus vs Maximus)&lt;/b&gt;&lt;br&gt;No shared key. Match on normalised PAN / AADHAAR / PASSPORT / GSTIN, else MOBILE / EMAIL + DOB (+ name)&lt;br&gt;Output: match_method + confidence" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="840" y="255" width="430" height="115" as="geometry"/></mxCell><mxCell id="d4" value="PARTY_XREF&lt;br&gt;partner_party_hkey, travel_party_hkey, match_method, confidence" style="shape=cylinder3;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="1330" y="250" width="220" height="125" as="geometry"/></mxCell><mxCell id="d5" value="Open: is Opus travel part_id the same ID space as Opus partner part_id? Duplicates per PAN / mobile? (see questions)" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="565" y="400" width="705" height="40" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;MAXIMUS_TRAVEL&lt;/b&gt;&lt;br&gt;LNK_POLICY_PARTY (POLICY_HKEY, PARTY_HKEY)&lt;br&gt;+ SAT_LNK_POLICY_PARTY_ROLE.PARTY_ROLE_TYPE&lt;br&gt;Claims: LINK_CLAIM_PARTY (claimant, insured)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="440" height="110" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;OPUS_TRAVEL&lt;/b&gt;&lt;br&gt;No LNK_POLICY_PARTY in the model. Derive from staging: BA_TRV_DATA_POLICY_DTLS (trv_data_no + payer_part_id / cft_mst_comp_ref) and BJAZ_TRV_LOADER_DATA (policy_ref + part_id / premiumpayerid). Insured members: SAT_RISK_PERSON_INSURED (name only)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="560" y="500" width="520" height="110" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;Role classification&lt;/b&gt;&lt;br&gt;PURCHASER (proposer / payer)&lt;br&gt;INSURED (member)&lt;br&gt;CLAIMANT" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="1150" y="500" width="400" height="110" as="geometry"/></mxCell><mxCell id="t4" value="Travel LOB only: filter by product / policy source so Opus or Maximus health and motor policies are not counted" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="70" y="655" width="1010" height="40" as="geometry"/></mxCell><mxCell id="o1" value="HUB_POLICY + SAT_POLICY_HEADER&lt;br&gt;policy no, issue date, risk start / end, sum insured" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="70" y="760" width="420" height="70" as="geometry"/></mxCell><mxCell id="o2" value="HUB_PRODUCT + SAT_PRODUCT_DEFINITION&lt;br&gt;product / plan code and name" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="560" y="760" width="520" height="70" as="geometry"/></mxCell><mxCell id="o3" value="HUB_CLAIM + SAT_CLAIM_HEADER / SAT_CLAIM_TRAVEL_DETAIL (Maximus travel only)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="1150" y="760" width="400" height="70" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;OUTPUT: PARTNER_TRAVEL_LINEAGE&lt;/b&gt; (one row per partner x travel policy x role)&lt;br&gt;partner_party_hkey | partner_source | travel_party_hkey | match_method | confidence | role | policy_no | product | policy start / end | travel_source | claim_count" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe599;strokeColor=#bf9000;fontSize=14;strokeWidth=2;shadow=1;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="1560" height="70" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="p0" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.375;entryPerimeter=0;" edge="1" parent="1" source="p1" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.625;entryPerimeter=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="p3" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="220"/><mxPoint x="285" y="220"/></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.496;exitPerimeter=0;entryX=0.0;entryY=0.496;entryPerimeter=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="no / not enough" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.496;exitPerimeter=0;entryX=0.0;entryY=0.496;entryPerimeter=0;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.496;exitPerimeter=0;entryX=0.0;entryY=0.496;entryPerimeter=0;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="yes" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.25;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="d2" target="d4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="665" y="388"/><mxPoint x="1385" y="388"/></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="d4" target="t1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1495" y="465"/><mxPoint x="290" y="465"/></Array></mxGeometry></mxCell><mxCell id="e11" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="d4" target="t2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1495" y="465"/><mxPoint x="820" y="465"/></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.15;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="t1" target="t3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="632"/><mxPoint x="1210" y="632"/></Array></mxGeometry></mxCell><mxCell id="e14" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="t3" target="o1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1490" y="725"/><mxPoint x="280" y="725"/></Array></mxGeometry></mxCell><mxCell id="e15" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="t3" target="o2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1490" y="725"/><mxPoint x="820" y="725"/></Array></mxGeometry></mxCell><mxCell id="e16" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="t3" target="o3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1490" y="725"/><mxPoint x="1350" y="725"/></Array></mxGeometry></mxCell><mxCell id="e17" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.167;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="o1" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.513;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="o2" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontColor=#1f1f1f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.853;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="o3" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>