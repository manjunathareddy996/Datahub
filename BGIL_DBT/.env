# Shared BGIL dbt env. Loaded by env_var() in profiles.yml and dbt_project.yml.
# dbt >= 1.12 auto-loads from CWD; otherwise: set -a && source BGIL_DBT/.env && set +a
# No secrets here -- account/user come from Snowflake CLI connection.

# Target (curated vault)
BGIL_TARGET_DB_DEV=BAGIC_PREPROD_CURATED_DB
BGIL_TARGET_DB_PROD=BAGIC_PREPROD_CURATED_DB
BGIL_VAULT_SCHEMA=BGIL_DATA_MODEL
BGIL_WH=BAGIC_DPM_MAXI_RAW_WH
BGIL_DEV_ROLE=INGESTION_PREPROD_ROLE
BGIL_PROD_ROLE=EMPOWER_FOUNDATION_ROLE
BGIL_RUN_LOG_TABLE=BAGIC_PREPROD_CURATED_DB.UTILS.MAXI_RAW_DBT_MODEL_RUN_LOG

# Source: Maximus
MAXIMUS_DB=BAGIC_PROD_MIRROR_DB
MAXIMUS_SCHEMA=MAXI_RAW

# Source: Opus
OPUS_DB=BAGIC_PROD_MIRROR_DB
OPUS_SCHEMA=OPUS_GG_DWHSTAGE
OPUS_TEST_DB=BAGIC_PREPROD_CURATED_DB
OPUS_TEST_SCHEMA=UTILS
