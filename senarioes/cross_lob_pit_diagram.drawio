                <mxCell id="mart_label" value="&lt;b&gt;MART LAYER&lt;/b&gt;" style="text;html=1;fontSize=13;fontColor=#6c3483;align=center;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="240" y="565" width="200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="mart" value="&lt;b&gt;mart_party_identity&lt;/b&gt; (join PIT pointers → real values + LEAD + COALESCE)&lt;br&gt;&lt;br&gt;PARTY_ID | NAME | GENDER | DOB | STATUS | EFF_FROM | EFF_TO&lt;br&gt;───────────────────────────────────────────&lt;br&gt;1001 | Ashraf | M | 1990-05-15 | ACTIVE | Jan1 09:00 | Jan1 10:00&lt;br&gt;1001 | Ashraf | M | 1990-05-15 | ACTIVE | Jan1 10:00 | Feb1 10:00&lt;br&gt;1001 | Ashraf | M | 1990-05-15 | VIP | Feb1 10:00 | Mar1 09:00&lt;br&gt;1001 | Ashraf | M | 1990-05-16 | VIP | Mar1 09:00 | NULL&lt;br&gt;&lt;br&gt;&lt;i&gt;Row 3: Partner changed STATUS to VIP (Feb1). Health DOB unchanged.&lt;/i&gt;&lt;br&gt;&lt;i&gt;Row 4: Health corrected DOB (Mar1). Partner STATUS unchanged.&lt;/i&gt;&lt;br&gt;&lt;i&gt;No phantom combinations — each LOB resolves independently.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#000000;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;strokeWidth=2;" parent="1" vertex="1">
