                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="data_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="820" y="350" width="400" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="data_text" value="&lt;b&gt;Satellite Data (party ABC = Ashraf)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Health sat_party_identity:&lt;/b&gt;&lt;br&gt;ABC | Jan1 09:00 | Ashraf | M | 1990-05-15 | ACTIVE&lt;br&gt;ABC | Mar1 09:00 | Ashraf | M | 1990-05-16 | ACTIVE&lt;br&gt;&lt;i&gt;(DOB corrected on Mar1)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Partner sat_party_identity:&lt;/b&gt;&lt;br&gt;ABC | Jan1 10:00 | Ashraf | M | 1990-05-15 | ACTIVE&lt;br&gt;ABC | Feb1 10:00 | Ashraf | M | 1990-05-15 | VIP&lt;br&gt;&lt;i&gt;(STATUS changed on Feb1)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;COALESCE priority (business decision):&lt;/b&gt;&lt;br&gt;• DOB → Health wins (member system of record)&lt;br&gt;• STATUS → Partner wins (intermediary system)&lt;br&gt;&lt;br&gt;&lt;b&gt;Prerequisite:&lt;/b&gt; Both LOBs use same hub key&lt;br&gt;'HUB_PARTY|' || same_business_id → same PARTY_HK" style="text;html=1;fontSize=9;fontColor=#000000;align=left;verticalAlign=top;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="830" y="355" width="380" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="rules_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="820" y="630" width="400" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="rules_text" value="&lt;b&gt;Cross-LOB PIT Rules:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Both LOBs MUST hash same business key identically&lt;br&gt;2. Keep satellites separate per LOB (don't merge physically)&lt;br&gt;3. as_of_date = UNION of LOAD_DATETIMEs from ALL sats&lt;br&gt;4. PIT has one pointer column PER LOB satellite&lt;br&gt;5. COALESCE priority = business decision in mart, not vault&lt;br&gt;6. Both LOB satellites untouched — priority reversible anytime" style="text;html=1;fontSize=9;fontColor=#000000;align=left;verticalAlign=top;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="830" y="635" width="380" height="120" as="geometry"/>
                </mxCell>
